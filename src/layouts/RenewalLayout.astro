---
import "../styles/renewal.css";
import RenewalHeader from "../components/renewal/RenewalHeader.astro";
import { getPageSettings } from "../lib/renewal-api";
import anzuFont from "../../あんずもじ2020/AP.ttf";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  useCmsContent?: boolean;
}

const {
  title,
  description,
  home = false,
  useCmsContent = true,
} = Astro.props;

const pageSettings = await getPageSettings(Astro.url.pathname);
const resolvedPageTitle = useCmsContent ? pageSettings?.title : title;
const resolvedDescription = useCmsContent ? pageSettings?.description : description;
const documentTitle = resolvedPageTitle
  ? `${resolvedPageTitle} | MuST Music Spot Tokyo`
  : "MuST | Music Spot Tokyo";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {home && <link rel="preload" href={anzuFont} as="font" type="font/ttf" crossorigin />}
    <meta name="theme-color" content="#020d17" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{documentTitle}</title>
  </head>
  <body class="renewal-site">
    <div class:list={["renewal-shell", { "renewal-shell--home": home }]}>
      <RenewalHeader />
      <main class="renewal-main">
        <slot />
      </main>
    </div>
  </body>
</html>
