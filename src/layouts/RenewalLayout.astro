---
import "../styles/renewal.css";
import RenewalHeader from "../components/renewal/RenewalHeader.astro";

interface Props {
	title?: string;
	description?: string;
	home?: boolean;
}

const {
	title,
	description = "MuST（マスト）は、東京都内でライブを楽しむ社会人軽音サークルです。",
	home = false,
} = Astro.props;

const pageTitle = title ? `${title} | MuST Music Spot Tokyo` : "MuST | Music Spot Tokyo";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;800&family=Zen+Old+Mincho:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="theme-color" content="#020d17" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{pageTitle}</title>
	</head>
	<body class="renewal-site">
		<div class:list={["renewal-shell", { "renewal-shell--home": home }]}>
			<RenewalHeader />
			<main class="renewal-main">
				<slot />
			</main>
		</div>
	</body>
</html>
