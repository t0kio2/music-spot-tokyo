---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RecruitCta from "../components/RecruitCta.astro";
import { getPageSettings, Api } from "../lib/api";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  useCmsContent?: boolean;
}

const { title, description, home = false, useCmsContent = true } = Astro.props;

const pageSettings = await getPageSettings(Astro.url.pathname);
const overview = await Api.getOverview();
const hasRecruitCta = Boolean(overview.recruiting?.is_recruiting && overview.recruiting.message);
const isApplicationPage = Astro.url.pathname === "/application/";
const resolvedPageTitle = useCmsContent ? pageSettings?.title : title;
const defaultDescription =
  "MuST（マスト）は、東京都内で活動する社会人向けの軽音サークルです。ライブハウスでのセッションやライブを楽しめます。";
const resolvedDescription = useCmsContent
  ? pageSettings?.seo_description || pageSettings?.description || defaultDescription
  : description || defaultDescription;
const documentTitle = resolvedPageTitle
  ? resolvedPageTitle
  : "MuST | Music Spot Tokyo";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#020d17" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{documentTitle}</title>
    <script is:inline>
      const isGaDisabled = new URLSearchParams(window.location.search).has("no_ga");

      if (isGaDisabled) {
        const preserveNoGa = (anchor) => {
          const href = anchor.getAttribute("href");
          if (!href || href.startsWith("#")) return;

          const destination = new URL(href, window.location.href);
          if (
            destination.origin !== window.location.origin ||
            destination.searchParams.has("no_ga")
          ) {
            return;
          }

          destination.search += `${destination.search ? "&" : "?"}no_ga`;
          anchor.href = destination.href;
        };

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          const anchor = event.target.closest("a[href]");
          if (anchor) preserveNoGa(anchor);
        });
        document.addEventListener("auxclick", (event) => {
          if (!(event.target instanceof Element)) return;
          const anchor = event.target.closest("a[href]");
          if (anchor) preserveNoGa(anchor);
        });
      }
    </script>
    {gaMeasurementId && <script is:inline define:vars={{ gaMeasurementId }}>
      if (!new URLSearchParams(window.location.search).has("no_ga")) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function (...args) {
          window.dataLayer.push(args);
        };
        window.gtag("js", new Date());
        window.gtag("config", gaMeasurementId, { send_page_view: true });

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
        document.head.append(script);
      }
    </script>}
  </head>
  <body class="site">
    <div class:list={["shell", { "shell--home": home }]}>
      <Header />
      <main class="main">
        <slot />
      </main>
      {hasRecruitCta && overview.recruiting && (
        <RecruitCta recruiting={overview.recruiting} applicationPage={isApplicationPage} />
      )}
      {!hasRecruitCta && <Footer />}
    </div>
  </body>
</html>
