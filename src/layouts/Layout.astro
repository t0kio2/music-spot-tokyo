---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
	structuredData?: Record<string, unknown>[];
}

const {
	title,
	description = "MuST（マスト）は、「気軽」に「気の合う仲間」とライブハウスで演奏できる、東京都内の社会人軽音サークルです。",
	structuredData = [],
} = Astro.props;

const pageTitle =
	!title
		? "東京都内の社会人軽音サークル MuST（マスト）| お一人・初心者歓迎"
		: title === "MuST-Music Spot Tokyo-" ? title : `${title} | MuST-Music Spot Tokyo-`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL("/", Astro.site);
const ogImageUrl = new URL("/icon.webp", siteUrl);
const breadcrumbName = title ?? "ホーム";
const breadcrumbItems = [
	{
		"@type": "ListItem",
		position: 1,
		name: "ホーム",
		item: siteUrl.href,
	},
	...(Astro.url.pathname === "/"
		? []
		: [
				{
					"@type": "ListItem",
					position: 2,
					name: breadcrumbName,
					item: canonicalUrl.href,
				},
			]),
];
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		...(Astro.url.pathname === "/"
			? [
					{
						"@type": "WebSite",
						name: "MuST-Music Spot Tokyo-",
						alternateName: "MuST（マスト）",
						url: siteUrl.href,
					},
				]
			: []),
		{
			"@type": "Organization",
			name: "MuST-Music Spot Tokyo-",
			alternateName: "MuST（マスト）",
			url: siteUrl.href,
			logo: new URL("/icon.webp", siteUrl).href,
			sameAs: [
				"https://youtube.com/@MuST-Music_Spot_Tokyo-",
				"https://www.instagram.com/must_music_spot_tokyo/",
				"https://x.com/MusicSpot_Tokyo",
			],
		},
		...(Astro.url.pathname === "/"
			? []
			: [
					{
						"@type": "BreadcrumbList",
						itemListElement: breadcrumbItems,
					},
				]),
		...structuredData,
	],
}).replace(/</g, "\\u003c");
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="MuST-Music Spot Tokyo-" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1408" />
		<meta property="og:image:height" content="768" />
		<meta property="og:image:alt" content="MuST-Music Spot Tokyo- ロゴ" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="MuST-Music Spot Tokyo- ロゴ" />
		<script type="application/ld+json" set:html={jsonLd}></script>
		<title>{pageTitle}</title>
		{
			gaMeasurementId && (
				<>
					<script
						async
						src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
						is:inline
					></script>
					<script is:inline define:vars={{ gaMeasurementId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", gaMeasurementId);
					</script>
				</>
			)
		}
	</head>
	<body>
		<div class="site">
			<Header />
			<main class="content">
				<div class="content-body">
					<div class="page-content">
						<slot />
					</div>
					<div class="mobile-footer">
						<Footer />
					</div>
				</div>
			</main>
		</div>
	</body>
</html>

<style>
	.content-body {
		display: contents;
	}

	.page-content {
		display: contents;
	}

	.mobile-footer {
		display: none;
	}

	.site {
		--topbar-height: 4.25rem;
		height: 100svh;
		overflow: hidden;
	}

	.content {
		position: fixed;
		inset: var(--topbar-height) 0 0 var(--sidebar-width);
		min-width: 0;
		padding: 1.5rem 2.5rem 4rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	@media (max-width: 960px) {
		.content-body {
			display: grid;
			grid-template-rows: 1fr auto;
			min-height: calc(100svh - var(--topbar-height) - 2.25rem - env(safe-area-inset-bottom, 0px));
			row-gap: 6rem;
		}

		.page-content {
			display: block;
			min-width: 0;
		}

		.mobile-footer {
			display: block;
		}

		.content {
			inset-inline-start: 0;
			padding: 1.5rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
		}
	}
</style>
