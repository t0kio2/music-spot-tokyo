---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "MuST-Music Spot Tokyo-",
	description = "MuST（マスト）は、「気軽」に「気の合う仲間」とライブハウスで演奏できる、東京都内の社会人軽音サークルです。",
} = Astro.props;

const pageTitle =
	title === "MuST-Music Spot Tokyo-" ? title : `${title} | MuST-Music Spot Tokyo-`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="site">
			<Header />
			<main class="content">
				<slot />
				<Footer />
			</main>
		</div>
	</body>
</html>

<style>
	.site {
		--topbar-height: 4.25rem;
		height: 100svh;
		overflow: hidden;
	}

	.content {
		position: fixed;
		inset: var(--topbar-height) 0 0 var(--sidebar-width);
		min-width: 0;
		padding: 1.5rem 2.5rem 4rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	@media (max-width: 960px) {
		.content {
			inset-inline-start: 0;
			padding: 1.5rem 1.25rem 3rem;
		}
	}
</style>
