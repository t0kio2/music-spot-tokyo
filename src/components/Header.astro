---
import { getPageList } from "../lib/microcms";
import { pageSlugToPath } from "../lib/page";
import Footer from "./Footer.astro";

const pages = await getPageList();

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const socials = [
	{
		href: "https://youtube.com/@MuST-Music_Spot_Tokyo-",
		label: "YouTube",
		icon: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z",
	},
	{
		href: "https://www.instagram.com/must_music_spot_tokyo/",
		label: "Instagram",
		icon: "M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.6.36 3.6 1.35 1 1 1.29 2.33 1.35 3.6.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.36 2.6-1.35 3.6-1 1-2.33 1.29-3.6 1.35-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-2.6-.36-3.6-1.35-1-1-1.29-2.33-1.35-3.6C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.36-2.6 1.35-3.6 1-1 2.33-1.29 3.6-1.35C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.5 0-4.75.07-1 .05-1.9.24-2.5.85-.6.6-.8 1.5-.85 2.5C3.8 8.5 3.8 8.86 3.8 12s0 3.5.1 4.75c.05 1 .24 1.9.85 2.5.6.6 1.5.8 2.5.85 1.25.06 1.61.06 4.75.06s3.5 0 4.75-.06c1-.05 1.9-.25 2.5-.85.6-.6.8-1.5.85-2.5.06-1.25.06-1.61.06-4.75s0-3.5-.06-4.75c-.05-1-.25-1.9-.85-2.5-.6-.6-1.5-.8-2.5-.85C15.5 4 15.14 4 12 4Zm0 3.4a4.6 4.6 0 1 1 0 9.2 4.6 4.6 0 0 1 0-9.2Zm0 1.8a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6Zm4.8-2a1.08 1.08 0 1 1 0 2.15 1.08 1.08 0 0 1 0-2.15Z",
	},
	{
		href: "https://www.twitter.com/MusicSpot_Tokyo",
		label: "X (Twitter)",
		icon: "M18.24 3H21l-6.3 7.2L22 21h-6.14l-4.8-6.28L5.5 21H2.7l6.74-7.7L2 3h6.28l4.34 5.74L18.24 3Zm-1.07 16.13h1.51L7.9 4.78H6.28l10.89 14.35Z",
	},
	{
		href: "https://circle-book.com/circles/5638",
		label: "Circle Book",
		icon: "M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z",
	},
];
---

<input type="checkbox" id="nav-toggle" class="nav-toggle" />

<div class="topbar">
	<a href="/" class="mobile-logo">MuST-Music Spot Tokyo-</a>
	<div class="socials">
		{
			socials.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={s.icon} /></svg>
				</a>
			))
		}
	</div>
	<label for="nav-toggle" class="hamburger" aria-label="メニュー">
		<span></span>
		<span></span>
		<span></span>
	</label>
</div>

<label for="nav-toggle" class="scrim"></label>

<aside class="sidebar">
	<a href="/" class="logo">
		<span>MuST-Music</span>
		<span>Spot Tokyo-</span>
	</a>

	<nav class="nav">
		<ul>
			{
				pages.map((page) => (
					<li>
						<a
							href={pageSlugToPath(page.slug)}
							class={isActive(pageSlugToPath(page.slug)) ? "active" : ""}
						>
							{page.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="socials sidebar-socials">
		{
			socials.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={s.icon} /></svg>
				</a>
			))
		}
	</div>
	<Footer sidebar />
</aside>

<style>
	.nav-toggle {
		display: none;
	}

	.topbar {
		position: fixed;
		inset: 0 0 auto var(--sidebar-width);
		height: var(--topbar-height);
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.5rem;
		padding: 0 1.5rem;
		background-color: var(--color-bg);
		background-image: url("/images/bg-pattern.png");
	}

	.mobile-logo {
		display: none;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		color: var(--color-ink);
		margin-right: auto;
	}

	.socials {
		display: flex;
		gap: 1.1rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.socials a:hover {
		color: var(--color-accent);
	}

	.sidebar-socials {
		display: none;
	}

	.hamburger {
		display: none;
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		padding: 0.4rem;
	}

	.hamburger span {
		width: 22px;
		height: 2px;
		background: #fff;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.scrim {
		display: none;
	}

	.sidebar {
		position: fixed;
		inset: 0 auto 0 0;
		z-index: 50;
		width: var(--sidebar-width);
		padding: 3.5rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100svh;
	}

	.logo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		align-self: stretch;
		font-family: var(--font-serif);
		font-size: 1.7rem;
		line-height: 1.35;
		color: var(--color-ink);
		margin-bottom: 3.5rem;
	}

	.nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		flex: 1;
		justify-content: center;
	}
	.nav ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.15rem;
	}

	.nav a {
		font-size: 0.92rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.8);
		text-align: center;
		transition: color 0.15s ease;
	}

	.nav a:hover {
		color: #fff;
	}

	.nav a.active {
		color: var(--color-accent);
	}

	@media (max-width: 960px) {
		.topbar {
			inset-inline-start: 0;
			padding: 0 1.25rem;
			justify-content: flex-end;
		}

		.mobile-logo {
			display: block;
		}

		.topbar > .socials {
			display: none;
		}

		.hamburger {
			display: flex;
		}

		.sidebar {
			position: fixed;
			inset: 0 0 0 auto;
			height: 100svh;
			width: min(300px, 82vw);
			padding: 5rem 2rem 2rem;
			transform: translateX(100%);
			transition: transform 0.25s ease;
			z-index: 60;
			background-color: var(--color-bg);
			background-image: url("/images/bg-pattern.png");
		}

		.logo {
			align-items: center;
			text-align: center;
		}

		.sidebar-socials {
			display: flex;
			margin-top: 2rem;
		}

		.nav-toggle:checked ~ .sidebar {
			transform: translateX(0);
		}

		.nav-toggle:checked ~ .scrim {
			display: block;
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.5);
			z-index: 55;
		}

		.nav-toggle:checked ~ .topbar .hamburger span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.nav-toggle:checked ~ .topbar .hamburger span:nth-child(2) {
			opacity: 0;
		}

		.nav-toggle:checked ~ .topbar .hamburger span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>
