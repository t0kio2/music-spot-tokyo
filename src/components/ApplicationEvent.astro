---
import Icon from "./Icon.astro";
import styles from "./ApplicationEvent.module.css";
import {
  formatEventDate,
  getEventTypeLabel,
  parseDate,
  type Application,
} from "../lib/api";

interface Props {
  event: Application;
}

const { event } = Astro.props;
const schedule = event.regular_session_info[0];
const isClosed = event.is_closed;
const isBand = event.event_type === "band";
const isStatusOnly = !isBand && !schedule;
const hasStatusMessage = event.status_message !== "パートごとの募集状況";
const statusLabel = (status: string) =>
  status === "waitlist" ? "キャンセル待ち" : status === "open" ? "募集中" : "募集終了";
const eventDate = event.event_date ? parseDate(event.event_date) : undefined;
const formatMonth = (month: number) =>
  month < 10 ? String.fromCharCode("０".charCodeAt(0) + month) : String(month);
const recruitmentAge = "1987〜1999年生まれ";
---

<article
  class:list={[
    "application__event",
    { "application__event--band": isBand },
    { "application__event--project": event.event_type === "project" },
    { "application__event--status-only": isStatusOnly },
  ]}
>
  <button
    class:list={[
      "application__poster",
      { "application__poster--orange": event.event_type === "regular" },
      { "application__poster--empty": !event.flyer },
    ]}
    type="button"
    data-lightbox-src={event.flyer?.url}
    style={
      event.flyer
        ? `background-image: linear-gradient(180deg, transparent 35%, rgba(0,0,0,.7)), url(${event.flyer.url})`
        : undefined
    }
    aria-label={event.flyer ? `${event.title}のチラシを拡大表示` : "チラシなし"}
    disabled={!event.flyer}
  ></button>

  <div class="application__info">
    <div class="application__title">
      <time>
        <span>{eventDate?.getUTCFullYear() ?? ""}</span>
        <b>{eventDate ? `${formatMonth(eventDate.getUTCMonth() + 1)}月` : "未定"}</b>
      </time>
      <div class={styles.titleContent}>
        <h2>{event.title}</h2>
        <small
          class:list={[
            styles.eventType,
            {
              [styles.project]: event.event_type === "project",
              [styles.band]: event.event_type === "band",
            },
          ]}
        >{getEventTypeLabel(event.event_type)}</small>
      </div>
    </div>
    {event.event_date || event.place || event.fee ? (
      <>
        <dl class="application__details-list">
          <div class={styles.dateDetail}>
            <dt>
              <Icon name="calendar" />
              <b>日時</b>
            </dt>
            <dd>
              <span>
                {formatEventDate(event.event_date)}
                {event.event_time && (
                  <>
                    <br />
                    {event.event_time}
                  </>
                )}
              </span>
            </dd>
          </div>
          <div>
            <dt>
              <Icon name="pin" />
            </dt>
            <dd>
              <b>会場</b>
              <span>{event.place ?? "未定"}</span>
            </dd>
          </div>
          <div>
            <dt>¥</dt>
            <dd>
              <b>費用</b>
              <span>{event.fee ?? "未定"}</span>
            </dd>
          </div>
          {!isBand && (
            <div class={styles.ageDetail}>
              <dt aria-hidden="true"></dt>
              <dd>
                <b>対象年齢</b>
                <span>{recruitmentAge}</span>
              </dd>
            </div>
          )}
        </dl>
        {isBand && (
          <p class="application__recruitment-note application__recruitment-note--details">
            観覧者のみの募集です。<br />出演者の募集は行なっておりません。
          </p>
        )}
      </>
    ) : (
      <p class="application__undecided">日程・内容は未定です。</p>
    )}
  </div>

  {event.performers.length > 0 && (
    <div class:list={["application__roster", styles.roster]}>
      <h3>出演</h3>
      <ol>
        {event.performers.map((performer, index) => (
          <li>
            <span>{index + 1}</span>
            <time class={styles.performerTime}>{performer.start_at ?? ""}</time>
            <span class={styles.performerName}>{performer.name}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  {schedule && (
    <div class:list={["application__schedule", styles.schedule]}>
      {schedule.setlist_select_msg && (
        <div
          class:list={[
            "application__schedule-item",
            styles.scheduleItem,
            styles.selectionItem,
          ]}
        >
          <h3>選曲について</h3>
          <p>{schedule.setlist_select_msg}</p>
        </div>
      )}
      {schedule.practice_date && (
        <div class="application__schedule-item">
          <h3>練習会</h3>
          <p>
            <span class={styles.scheduleLine}>
              <span class={styles.metaIcon}>
                <Icon name="calendar" />
              </span>
              <span>{schedule.practice_date}</span>
            </span>
            <span class={styles.scheduleLine}>
              <span class={styles.metaIcon}>
                <Icon name="pin" />
              </span>
              <span>{schedule.practice_place ?? "場所未定"}</span>
            </span>
            {schedule.practice_fee ? (
              <span class={styles.scheduleLine}>
                <span class={styles.currency}>¥</span>
                <span>{schedule.practice_fee}</span>
              </span>
            ) : null}
          </p>
        </div>
      )}
    </div>
  )}

  {!isBand && (
    <details
      open
      class:list={[
        "application__status",
        { "application__status--closed": isClosed },
      ]}
    >
      <summary>
        <span>
          <Icon name="users" />
        </span>
        募集状況
      </summary>
      {event.recruit_spreadsheet_url ? (
        <>
          <p>以下のリンクから空きパート一覧が確認できます。</p>
          <a
            class="application__spreadsheet-link"
            href={event.recruit_spreadsheet_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {event.recruit_spreadsheet_url}
          </a>
        </>
      ) : event.parts.length > 0 ? (
        <>
          {hasStatusMessage && <p>{event.status_message}</p>}
          <div class="application__vacancies">
            {event.parts.map((part) => (
              <span>
                ♬ {part.part_name}{" "}
                <b
                  class:list={{
                    "is-wait": part.status === "waitlist",
                    "is-closed": part.status === "closed",
                  }}
                >
                  {statusLabel(part.status)}
                </b>
              </span>
            ))}
          </div>
        </>
      ) : (
        <p>{event.status_message}</p>
      )}
      <p class="application__recruitment-note application__recruitment-note--status">
        ※ボーカルのみ音源の提出をご準備いただいております。1分30秒ほどのものを２曲分でカラオケや弾き語りの録音など形式は問いません。
      </p>
    </details>
  )}
</article>

<script>
  const desktopQuery = window.matchMedia("(min-width: 761px)");
  const syncStatusDetails = () => {
    document.querySelectorAll<HTMLDetailsElement>(".application__status").forEach(
      (details) => {
        if (desktopQuery.matches) details.open = true;
      },
    );
  };

  syncStatusDetails();
  desktopQuery.addEventListener("change", syncStatusDetails);
</script>
