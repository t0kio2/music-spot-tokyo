---
const navItems = [
	["/renewal/", "ホーム", "home"],
	["/renewal/overview/", "MuSTについて", "users"],
	["/renewal/setlist/", "演奏曲について", "music"],
	["/renewal/benefit/", "活動実績", "chart"],
	["/renewal/benefit/#archive", "過去のライブ", "play"],
	["/renewal/flow/", "参加までの流れ", "nodes"],
	["/renewal/faq/", "よくある質問", "question"],
	["/renewal/precautions/", "注意事項", "warning"],
	["/renewal/application/", "募集・申込み", "document"],
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/renewal/" ? currentPath === href : currentPath.startsWith(href);
---

<header class="renewal-header">
	<a class="renewal-brand" href="/renewal/" aria-label="MuST ホーム">
		<img src="/favicon-source.png" alt="" />
	</a>
	<input class="renewal-menu-toggle" type="checkbox" id="renewal-menu-toggle" />
	<label class="renewal-menu-button" for="renewal-menu-toggle" aria-label="メニューを開く">
		<span></span><span></span><span></span>
	</label>
	<nav class="renewal-nav" aria-label="新デザインのメインナビゲーション">
		{navItems.map(([href, label, icon]) => (
			<a href={href} class:list={{ active: isActive(href) }}>
				<span class="renewal-nav__icon" aria-hidden="true">
					{icon === "home" && <svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" /></svg>}
					{icon === "users" && <svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 20v-1.5a4 4 0 0 0-3-3.87M16 2.13a4 4 0 0 1 0 7.75" /></svg>}
					{icon === "music" && <svg viewBox="0 0 24 24"><path d="M9 18V5l10-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3ZM19 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z" /></svg>}
					{icon === "chart" && <svg viewBox="0 0 24 24"><path d="M3 20V10M9 20V4M15 20v-7M21 20V2M2 20h20" /></svg>}
					{icon === "play" && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m10 8 5 4-5 4V8Z" /></svg>}
					{icon === "nodes" && <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2" /><circle cx="5" cy="18" r="2" /><circle cx="19" cy="18" r="2" /><path d="m12 7-5 9m5-9 5 9M7 18h10" /></svg>}
					{icon === "question" && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.6 9a2.5 2.5 0 1 1 4.5 1.5c-.8.9-2.1 1.2-2.1 2.8M12 17h.01" /></svg>}
					{icon === "warning" && <svg viewBox="0 0 24 24"><path d="m12 3 10 18H2L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg>}
					{icon === "document" && <svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5V3Z" /><path d="M15 3v5h4M8 12h8M8 16h6" /></svg>}
				</span>{label}
			</a>
		))}
	</nav>
	<label class="renewal-menu-scrim" for="renewal-menu-toggle"></label>
	<div class="renewal-sidebar-meta">
		<small>© 2026 MuST - Music Spot Tokyo -</small>
	</div>
</header>
