---
import RenewalIcon from "./RenewalIcon.astro";
import styles from "./RenewalHeader.module.css";

const navItems = [
  ["/renewal/", "ホーム", "home"],
  ["/renewal/overview/", "MuSTについて", "users"],
  ["/renewal/history/", "活動実績", "chart"],
  ["/renewal/music-selection/", "演奏曲について", "music"],
  ["/renewal/archive/", "過去のライブ", "play"],
  ["/renewal/archive/past-songs/", "過去の演奏曲一覧", "play"],
  ["/renewal/flow/", "参加までの流れ", "nodes"],
  ["/renewal/application/", "募集・申込み", "document"],
  ["/renewal/faq/", "よくある質問", "question"],
  ["/renewal/precautions/", "注意事項", "warning"],
] as const;

const socialLinks = [
  {
    href: "https://www.instagram.com/must_music_spot_tokyo/",
    label: "Instagram",
    path: "M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.6.36 3.6 1.35 1 1 1.29 2.33 1.35 3.6.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.36 2.6-1.35 3.6-1 1-2.33 1.29-3.6 1.35-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-2.6-.36-3.6-1.35-1-1-1.29-2.33-1.35-3.6C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.36-2.6 1.35-3.6 1-1 2.33-1.29 3.6-1.35C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.5 0-4.75.07-1 .05-1.9.24-2.5.85-.6.6-.8 1.5-.85 2.5C3.8 8.5 3.8 8.86 3.8 12s0 3.5.1 4.75c.05 1 .24 1.9.85 2.5.6.6 1.5.8 2.5.85 1.25.06 1.61.06 4.75.06s3.5 0 4.75-.06c1-.05 1.9-.25 2.5-.85.6-.6.8-1.5.85-2.5.06-1.25.06-1.61.06-4.75s0-3.5-.06-4.75c-.05-1-.25-1.9-.85-2.5-.6-.6-1.5-.85-2.5-.85C15.5 4 15.14 4 12 4Zm0 3.4a4.6 4.6 0 1 1 0 9.2 4.6 4.6 0 0 1 0-9.2Zm0 1.8a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6Zm4.8-2a1.08 1.08 0 1 1 0 2.15 1.08 1.08 0 0 1 0-2.15Z",
  },
  {
    href: "https://youtube.com/@MuST-Music_Spot_Tokyo-",
    label: "YouTube",
    path: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z",
  },
  {
    href: "https://x.com/MusicSpot_Tokyo",
    label: "X",
    path: "M18.24 3H21l-6.3 7.2L22 21h-6.14l-4.8-6.28L5.5 21H2.7l6.74-7.7L2 3h6.28l4.34 5.74L18.24 3Zm-1.07 16.13h1.51L7.9 4.78H6.28l10.89 14.35Z",
  },
  {
    href: "https://circle-book.com/circles/5638",
    label: "Circle Book",
    path: "M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z",
  },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/renewal/") return currentPath === href;
  const hasMoreSpecificMatch = navItems.some(
    ([candidate]) =>
      candidate !== href && candidate.length > href.length && currentPath.startsWith(candidate),
  );
  return currentPath.startsWith(href) && !hasMoreSpecificMatch;
};
---

<header class={styles.header}>
  <a class={styles.brand} href="/renewal/" aria-label="MuST ホーム">
    <img src="/favicon-source.png" alt="" />
    <span class={styles.brandName}>
      <strong>MuST</strong>
      <small>Music Spot Tokyo</small>
    </span>
  </a>
  <input class={styles.menuToggle} type="checkbox" id="renewal-menu-toggle" />
  <label class={styles.menuButton} for="renewal-menu-toggle" aria-label="メニューを開く">
    <span></span>
    <span></span>
    <span></span>
  </label>
  <nav class={styles.nav} data-renewal-nav aria-label="新デザインのメインナビゲーション">
    <div class={styles.navBrand} aria-label="MuST - Music Spot Tokyo -">
      <strong>MuST</strong>
      <small>- Music Spot Tokyo -</small>
    </div>
    {navItems.map(([href, label, icon]) => (
      <a href={href} class:list={{ [styles.active]: isActive(href) }}>
        <span class={styles.navIcon} aria-hidden="true">
          <RenewalIcon name={icon} />
        </span>
        {label}
      </a>
    ))}
    <div class={styles.socials} aria-label="SNS">
      {socialLinks.map(({ href, label, path }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={path} />
          </svg>
        </a>
      ))}
    </div>
  </nav>
  <label class={styles.menuScrim} for="renewal-menu-toggle"></label>
  <div class={styles.sidebarMeta}>
    <small>© 2026 MuST - Music Spot Tokyo -</small>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLInputElement>("#renewal-menu-toggle");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-renewal-nav] a");

  const syncMenuState = () => {
    document.body.classList.toggle("renewal-menu-open", menuToggle?.checked ?? false);
  };

  menuToggle?.addEventListener("change", syncMenuState);
  menuLinks.forEach((link) =>
    link.addEventListener("click", () => {
      if (menuToggle) menuToggle.checked = false;
      syncMenuState();
    }),
  );
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menuToggle?.checked) return;
    menuToggle.checked = false;
    syncMenuState();
  });
</script>
