---
import type { RenewalRecruiting } from "../../lib/renewal-api";
import RenewalActionLink from "./RenewalActionLink.astro";
import styles from "./RenewalRecruitCta.module.css";

interface Props {
  recruiting: RenewalRecruiting;
}

const { recruiting } = Astro.props;
const style = recruiting.image
  ? `--renewal-recruit-image: url("${recruiting.image.url}");`
  : undefined;
---

<footer
  class:list={[
    "renewal-home__panel",
    "renewal-home__cta",
    "renewal-recruit-cta",
    styles.cta,
    { [styles.hasImage]: Boolean(recruiting.image) },
  ]}
  aria-label="メンバー募集"
  style={style}
>
  <p>{recruiting.message}</p>
  <RenewalActionLink
    href="/renewal/application/"
    label="募集状況・申込み"
    variant="warm"
    icon="person"
  />
</footer>
