---
import type { RenewalRecruiting } from "../../lib/renewal-api";
import { RENEWAL_APPLICATION_FORM_URL } from "../../lib/renewal-links";
import RenewalActionLink from "./RenewalActionLink.astro";
import styles from "./RenewalRecruitCta.module.css";

interface Props {
  recruiting: RenewalRecruiting;
  applicationPage?: boolean;
}

const { recruiting, applicationPage = false } = Astro.props;
const style = recruiting.image
  ? `--renewal-recruit-image: url("${recruiting.image.url}");`
  : undefined;
---

<footer
  class:list={[
    "renewal-home__panel",
    "renewal-home__cta",
    "renewal-recruit-cta",
    styles.cta,
    { [styles.hasImage]: Boolean(recruiting.image) },
  ]}
  aria-label="メンバー募集"
  style={style}
>
  <p>{recruiting.message}</p>
  <RenewalActionLink
    href={applicationPage ? RENEWAL_APPLICATION_FORM_URL : "/renewal/application/"}
    label={applicationPage ? "申込フォームへ" : "募集状況・申込み"}
    variant="warm"
    icon="person"
    target={applicationPage ? "_blank" : undefined}
    rel={applicationPage ? "noopener noreferrer" : undefined}
  />
</footer>
