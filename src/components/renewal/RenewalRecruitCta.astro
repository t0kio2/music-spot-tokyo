---
import { formatEventDate, getEventTypeLabel, type RenewalApplication } from "../../lib/renewal-api";
import RenewalActionLink from "./RenewalActionLink.astro";
import styles from "./RenewalRecruitCta.module.css";

interface Props {
  event: RenewalApplication;
}

const { event } = Astro.props;
---

<section
  class:list={["renewal-home__panel", "renewal-home__cta", "renewal-recruit-cta", styles.cta]}
  aria-label="メンバー募集"
>
  <p>
    現在、{formatEventDate(event.event_date)} の {getEventTypeLabel(event.event_type)} <br>
    のメンバーを募集中です。
  </p>
  <RenewalActionLink
    href={event.application_url ?? "/renewal/application/"}
    label="募集状況・申込み"
    variant="warm"
    icon="person"
  />
</section>
