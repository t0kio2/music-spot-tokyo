---
import RenewalActionLink from "./RenewalActionLink.astro";
import RenewalIcon from "./RenewalIcon.astro";
import styles from "./RenewalMusicInfoCards.module.css";

const expectationUrl =
  "https://docs.google.com/spreadsheets/d/1n2VCyuXXvkGQ8_iKN5uhzDKulJirdlGfL0ow-mEomuE/edit?gid=582182904#gid=582182904";
const pastSongsUrl =
  "https://docs.google.com/spreadsheets/d/19h6ZPFD9lsByzZjj2XxNL7cUtUJ1UfM2Na8mI4t9ANI/edit?gid=1150305144#gid=1150305144";
---

<div class={styles.cards}>
  <section class={styles.card}>
    <h2>
      <RenewalIcon name="star-simple" className={styles.expectationIcon} />
      期待枠について
    </h2>
    <p>
      約２曲を「期待枠」から採用します。
      <br />
      リンク先にリストアップされたアーティストの「代表曲」から参照します。
    </p>
    <RenewalActionLink
      href={expectationUrl}
      label="詳細を見る"
      size="compact"
      centered
      target="_blank"
      rel="noopener noreferrer"
    />
  </section>
  <section class:list={[styles.card, styles.past]}>
    <h2>
      <RenewalIcon name="search" />
      過去の演奏曲について
    </h2>
    <p>
      過去３年以内に演奏した曲はリクエストできません。
      <br />
      リンク先の一覧から検索してご確認ください。
    </p>
    <RenewalActionLink
      href={pastSongsUrl}
      label="過去の演奏曲一覧を見る"
      size="compact"
      centered
      target="_blank"
      rel="noopener noreferrer"
    />
  </section>
</div>
