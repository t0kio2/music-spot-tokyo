---
interface Props {
	title: string;
	className?: string;
	home?: boolean;
}

const { title, className = "renewal-breadcrumb", home = false } = Astro.props;
---

<nav class={`renewal-breadcrumb ${className}`} aria-label="パンくずリスト">
	{home ? <span><svg class="renewal-breadcrumb__home-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" /></svg>{title}</span> : <><a href="/renewal/"><svg class="renewal-breadcrumb__home-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" /></svg>ホーム</a><span>›</span><span>{title}</span></>}
</nav>
