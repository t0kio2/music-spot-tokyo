---
import RenewalBreadcrumb from "./RenewalBreadcrumb.astro";
import styles from "./RenewalPageHero.module.css";

interface Props {
  title: string;
  description?: string;
  className: string;
  breadcrumbTitle?: string;
  parentTitle?: string;
  parentHref?: string;
  id?: string;
  compact?: boolean;
  style?: string;
}

const {
  title,
  description,
  className,
  breadcrumbTitle = title,
  parentTitle,
  parentHref,
  id,
  compact = false,
  style,
} = Astro.props;
---

<section
  class:list={[className, styles.hero, { [styles.compact]: compact }]}
  style={style}
  aria-labelledby={id}
>
  <RenewalBreadcrumb
    title={breadcrumbTitle}
    parentTitle={parentTitle}
    parentHref={parentHref}
    className={styles.breadcrumb}
  />
  <slot name="eyebrow" />
  {Astro.slots.has("title") ? (
    <slot name="title" />
  ) : (
    <h1 class={styles.title} id={id}>
      {title}
    </h1>
  )}
  {description && <p class={styles.description}>{description}</p>}
  <slot />
</section>
