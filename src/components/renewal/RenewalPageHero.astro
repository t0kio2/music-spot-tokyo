---
import RenewalBreadcrumb from "./RenewalBreadcrumb.astro";
import styles from "./RenewalPageHero.module.css";
import { getPageSettings, type RenewalMedia } from "../../lib/renewal-api";

interface Props {
  title?: string;
  description?: string;
  className: string;
  breadcrumbTitle?: string;
  subTitle?: string;
  parentTitle?: string;
  parentHref?: string;
  id?: string;
  compact?: boolean;
  style?: string;
  heroImage?: RenewalMedia;
  useCmsContent?: boolean;
}

const {
  title,
  description,
  className,
  breadcrumbTitle,
  subTitle,
  parentTitle,
  parentHref,
  id,
  compact = false,
  style,
  heroImage,
  useCmsContent = true,
} = Astro.props;
const pageSettings = await getPageSettings(Astro.url.pathname);
const resolvedTitle = useCmsContent ? pageSettings?.title : title;
const resolvedDescription = useCmsContent ? pageSettings?.description : description;
const resolvedSubTitle = useCmsContent ? pageSettings?.sub_title : subTitle;
const resolvedBreadcrumbTitle = useCmsContent
  ? pageSettings?.sidemenu_page_title
  : breadcrumbTitle;
const resolvedHeroImage = useCmsContent ? pageSettings?.hero_images[0] : heroImage;
const heroStyle = [
  resolvedHeroImage ? `--renewal-page-hero-image: url("${resolvedHeroImage.url}")` : "",
  style ?? "",
]
  .filter(Boolean)
  .join(";");
---

<section
  class:list={[className, styles.hero, { [styles.compact]: compact }]}
  style={heroStyle || undefined}
  aria-labelledby={id}
>
  <RenewalBreadcrumb
    title={resolvedBreadcrumbTitle ?? ""}
    parentTitle={parentTitle}
    parentHref={parentHref}
    className={styles.breadcrumb}
  />
  <slot name="eyebrow" />
  {Astro.slots.has("title") ? (
    <slot name="title" />
  ) : (
    <h1 class={styles.title} id={id}>
      {resolvedTitle}
      {resolvedSubTitle && <span class={styles.subtitle}>{resolvedSubTitle}</span>}
    </h1>
  )}
  {resolvedDescription && <p class={styles.description}>{resolvedDescription}</p>}
  <slot />
</section>
