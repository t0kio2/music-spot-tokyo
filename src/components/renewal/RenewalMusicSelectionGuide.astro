---
import RenewalIcon from "./RenewalIcon.astro";
import styles from "./RenewalMusicSelectionGuide.module.css";
---

<section class={styles.selection} aria-labelledby="selection-title">
  <div class={styles.copy}>
    <h2 id="selection-title">
      <RenewalIcon name="music" className={styles.icon} />
      選曲の目安
    </h2>
    <p>
      ここ10年以内にリリースされたJ-POPや邦ロックを中心に採用します。YouTube再生数が一定以上のある程度メジャーな曲が採用されやすいです。それ以前の年代は、国民的ヒット曲や近年バズった曲を少数採用します。
    </p>
    <p class={styles.note}>
      ただし、あくまで目安です。状況に応じて増減します。
      <br />
      ※目安を満たしたリクエスト曲が少ない場合、運営者セレクトの曲が選出される可能性もございます。
    </p>
  </div>
  <div
    class={styles.donut}
    role="img"
    data-renewal-music-chart
    aria-label="選曲の目安"
  >
    <strong>
      全体<em>24曲</em>（目安）
    </strong>
    <b class={styles.p50}>50%</b>
    <b class={styles.p17}>17%</b>
    <b class={styles.p8}>8%</b>
    <b class={styles.p17b}>17%</b>
    <b class={styles.p8b}>8%</b>
  </div>
  <div class={styles.legend}>
    <div>
      <i></i>
      <span>
        <span><span data-renewal-music-year="recent-start">—</span>年〜（12曲程度）</span>
        <small>YouTubeの再生回数を参考にしています。</small>
      </span>
      <b>50%</b>
    </div>
    <div>
      <i></i>
      <span>
        <span>
          <span data-renewal-music-year="previous-start">—</span>年〜<span
            data-renewal-music-year="previous-end">—</span>年（4曲程度）
        </span>
        <small>
          ここ10年以内にリリースされたJ-POPや邦ロックを中心に採用します。YouTube再生数が一定以上のある程度メジャーな曲が採用されやすいです。それ以前の年代は、国民的ヒット曲や近年バズった曲を少数採用します。
        </small>
      </span>
      <b>17%</b>
    </div>
    <div class={styles.oldLegend}>
      <i></i>
      <span>〜<span data-renewal-music-year="old-end">—</span>年（2曲程度）<small>当時、流行した。または近年バズった。</small></span>
      <b>8%</b>
    </div>
    <div>
      <i></i>
      <span>
        期待枠（2曲程度）<small>今後、活躍が期待されるアーティスト</small>
      </span>
      <b>8%</b>
    </div>
    <div>
      <i></i>
      <span>
        管楽器枠（4曲程度）<small>主に管楽器パートメンバーで話し合い決定</small>
      </span>
      <b>17%</b>
    </div>
  </div>
</section>

<script>
  const currentYear = Number(
    new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "Asia/Tokyo" }).format(new Date()),
  );
  const yearRanges = {
    recentStart: currentYear - 9,
    previousStart: currentYear - 19,
    previousEnd: currentYear - 10,
    oldEnd: currentYear - 20,
  };

  document.querySelectorAll("[data-renewal-music-year]").forEach((element) => {
    const key = element.dataset.renewalMusicYear;
    if (key === "recent-start") element.textContent = String(yearRanges.recentStart);
    if (key === "previous-start") element.textContent = String(yearRanges.previousStart);
    if (key === "previous-end") element.textContent = String(yearRanges.previousEnd);
    if (key === "old-end") element.textContent = String(yearRanges.oldEnd);
  });

  document.querySelectorAll("[data-renewal-music-chart]").forEach((chart) => {
    chart.setAttribute(
      "aria-label",
      `選曲の目安：${yearRanges.recentStart}年以降50%、${yearRanges.oldEnd}年以前8%、${yearRanges.previousStart}年から${yearRanges.previousEnd}年17%、期待枠8%、管楽器枠17%`,
    );
  });
</script>
