---
import "./ImageLightbox.module.css";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="activity__lightbox"
  data-lightbox
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={label}
>
  <button
    class="activity__lightbox-close"
    type="button"
    data-lightbox-close
    aria-label="画像を閉じる"
  >
    ×
  </button>
  <img data-lightbox-image src="" alt="" />
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  const lightboxImage = document.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const closeLightbox = () => {
    if (lightbox) lightbox.hidden = true;
  };

  document.querySelectorAll<HTMLElement>("[data-lightbox-src]").forEach((trigger) =>
    trigger.addEventListener("click", () => {
      const imageUrl = trigger.dataset.LightboxSrc;
      if (!imageUrl || !lightbox || !lightboxImage) return;
      lightboxImage.src = imageUrl;
      lightboxImage.alt = trigger.getAttribute("aria-label") ?? "画像";
      lightbox.hidden = false;
    }),
  );
  document.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLightbox();
  });
</script>
