---
export type IconName =
  | "home"
  | "users"
  | "music"
  | "mic"
  | "double-arrow"
  | "chart"
  | "play"
  | "nodes"
  | "question"
  | "warning"
  | "document"
  | "book"
  | "calendar"
  | "pin"
  | "line"
  | "star"
  | "star-simple"
  | "refresh"
  | "search"
  | "stage";

interface Props {
  name: IconName;
  className?: string;
}

const { name, className = "" } = Astro.props;
const isLine = name === "line";
const viewBox = isLine ? "0 0 32 24" : "0 0 24 24";
---

<svg class={className} viewBox={viewBox} aria-hidden="true">
  {name === "home" && <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" />}
  {name === "users" && (
    <path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 20v-1.5a4 4 0 0 0-3-3.87M16 2.13a4 4 0 0 1 0 7.75" />
  )}
  {name === "music" && (
    <path d="M9 18V5l10-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3ZM19 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z" />
  )}
  {name === "mic" && (
    <>
      <rect x="9" y="2" width="6" height="12" rx="3" />
      <path d="M5 11a7 7 0 0 0 14 0M12 18v4M8 22h8" />
    </>
  )}
  {name === "double-arrow" && <path d="m4 5 7 7-7 7m6-14 7 7-7 7" />}
  {name === "chart" && (
    <>
      <rect x="3" y="16" width="4" height="4" rx="0.7" />
      <rect x="10" y="12" width="4" height="8" rx="0.7" />
      <rect x="17" y="8" width="4" height="12" rx="0.7" />
      <path
        d="M4 9 9 5l4 2 5-5M16 2h3v3"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.8"
      />
    </>
  )}
  {name === "play" && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="m10 8 5 4-5 4V8Z" />
    </>
  )}
  {name === "nodes" && (
    <>
      <circle cx="12" cy="5" r="2" />
      <circle cx="5" cy="18" r="2" />
      <circle cx="19" cy="18" r="2" />
      <path d="m12 7-5 9m5-9 5 9M7 18h10" />
    </>
  )}
  {name === "question" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M9.6 9a2.5 2.5 0 1 1 4.5 1.5c-.8.9-2.1 1.2-2.1 2.8M12 17h.01" />
    </>
  )}
  {name === "warning" && (
    <>
      <path d="m12 3 10 18H2L12 3Z" />
      <path d="M12 9v5M12 17h.01" />
    </>
  )}
  {name === "document" && (
    <>
      <path d="M5 3h10l4 4v14H5V3Z" />
      <path d="M15 3v5h4M8 12h8M8 16h6" />
    </>
  )}
  {name === "book" && (
    <>
      <path d="M12 5.5C10.5 4 8.2 3 5 3H3v16h3c2.4 0 4.5.7 6 2 1.5-1.3 3.6-2 6-2h3V3h-2c-3.2 0-5.5 1-7 2.5Z" />
      <path d="M12 5.5V21M6 7h3M15 7h3M6 11h3M15 11h3" />
    </>
  )}
  {name === "calendar" && (
    <>
      <rect x="3" y="4" width="18" height="17" rx="2" />
      <path d="M8 2v4M16 2v4M3 9h18M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01" />
    </>
  )}
  {name === "star" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m12 6 1.8 3.7 4.2.6-3 2.9.7 4.2-3.7-2-3.7 2 .7-4.2-3-2.9 4.2-.6L12 6Z" />
    </>
  )}
  {name === "star-simple" && (
    <path d="m12 6 1.8 3.7 4.2.6-3 2.9.7 4.2-3.7-2-3.7 2 .7-4.2-3-2.9 4.2-.6L12 6Z" />
  )}
  {name === "refresh" && (
    <>
      <path d="M20 11a8 8 0 0 0-14.9-3M4 5v4h4M4 13a8 8 0 0 0 14.9 3M20 19v-4h-4" />
    </>
  )}
  {name === "search" && <path d="M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15ZM16 16l5 5" />}
  {name === "stage" && (
    <>
      <g transform="rotate(-12 5 4) translate(0.9 -0.55) scale(0.35)">
        <path d="M9 18V5l10-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3ZM19 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z" />
      </g>
      <g transform="rotate(10 17 4) translate(13 -1) scale(0.35)">
        <path d="M9 18V5l10-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3ZM19 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z" />
      </g>
      <circle cx="6" cy="14" r="1.4" />
      <circle cx="12" cy="13" r="1.6" />
      <circle cx="18" cy="14" r="1.4" />
      <path d="M2.5 21c.2-2.5 1.4-4 3.5-4s3.3 1.5 3.5 4M8 21c.2-3 1.5-4.7 4-4.7s3.8 1.7 4 4.7M14.5 21c.2-2.5 1.4-4 3.5-4s3.3 1.5 3.5 4" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === "line" && (
    <>
      <path d="M4 4.5A3.5 3.5 0 0 1 7.5 1h17A3.5 3.5 0 0 1 28 4.5v9A3.5 3.5 0 0 1 24.5 17H14l-5 4v-4H7.5A3.5 3.5 0 0 1 4 13.5Z" />
      <text
        x="16"
        y="11.7"
        text-anchor="middle"
        fill="currentColor"
        stroke="none"
        font-size="5"
        font-weight="700"
        letter-spacing=".15"
      >
        LINE
      </text>
    </>
  )}
</svg>
