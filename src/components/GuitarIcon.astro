---
import guitarIcon from "../assets/icons/guitar.svg";
import styles from "./GuitarIcon.module.css";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<span
  class:list={[styles.icon, className]}
  style={`--guitar-image: url(${guitarIcon.src})`}
  aria-hidden="true"
></span>
