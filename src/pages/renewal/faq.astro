---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../components/renewal/RenewalPageHero.astro";
import RenewalFaqList from "../../components/renewal/RenewalFaqList.astro";
import { getFaqList } from "../../lib/microcms";
const currentYear = new Date().getFullYear();
const youngestAge = currentYear - 2000;
const oldestAge = currentYear - 1987;
const faqs = (await getFaqList()).map((faq) => {
  if (!faq.question.includes("年齢層")) return faq;

  return {
    ...faq,
    answer: faq.answer
      .replace(
        /現在の参加者は\d+歳から\d+歳までです。/,
        `現在の参加者は${youngestAge}歳から${oldestAge}歳までです。`,
      )
      .replace(/その中でも多いのは\d+歳前後の方です。/, "その中でも多いのは30歳前後の方です。"),
  };
});
---

<RenewalLayout>
  <div class="renewal-faq-page">
    <RenewalPageHero
      className="renewal-faq-page__hero"
      compact
    />
    <section class="renewal-faq-page__content" aria-label="よくある質問一覧">
      <RenewalFaqList faqs={faqs} />
    </section>
  </div>
</RenewalLayout>
