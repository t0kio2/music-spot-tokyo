---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import { getFaqList } from "../../lib/microcms";
import { renewalMockApi, selectRecruitmentForBanner } from "../../lib/renewal-api";
const faqs = await getFaqList();
const recruitment = selectRecruitmentForBanner(await renewalMockApi.getApplication());
---
<RenewalLayout title="よくある質問" description="参加前によくいただくご質問をまとめました。">
	<div class="renewal-faq-page">
		<section class="renewal-faq-page__hero renewal-subpage-hero renewal-subpage-hero--compact"><RenewalBreadcrumb title="よくある質問" className="renewal-faq-page__breadcrumb" /><h1>よくある質問</h1><p>みなさまからのよくあるご質問をまとめました。</p></section>
		<section class="renewal-faq-page__content" aria-label="よくある質問一覧">
			<div class="renewal-faq-page__list">
				{faqs.map((faq, index) => <details><summary><span>Q{index + 1}</span><b>{faq.question}</b><i>＋</i></summary><div set:html={faq.answer} /> </details>)}
			</div>
		</section>
	</div>
	{recruitment && <RenewalRecruitCta event={recruitment} />}
</RenewalLayout>
