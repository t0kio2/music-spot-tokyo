---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../components/renewal/RenewalPageHero.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import { getFaqList } from "../../lib/microcms";
import { renewalApi, selectRecruitmentForBanner } from "../../lib/renewal-api";
const faqs = await getFaqList();
const recruitment = selectRecruitmentForBanner(await renewalApi.getApplication());
---

<RenewalLayout title="よくある質問" description="参加前によくいただくご質問をまとめました。">
  <div class="renewal-faq-page">
    <RenewalPageHero
      title="よくある質問"
      description="みなさまからのよくあるご質問をまとめました。"
      className="renewal-faq-page__hero"
      breadcrumbClassName="renewal-faq-page__breadcrumb"
      compact
    />
    <section class="renewal-faq-page__content" aria-label="よくある質問一覧">
      <div class="renewal-faq-page__list">
        {faqs.map((faq, index) => (
          <details>
            <summary>
              <span>Q{index + 1}</span>
              <b>{faq.question}</b>
              <i>＋</i>
            </summary>
            <div set:html={faq.answer} />{" "}
          </details>
        ))}
      </div>
    </section>
  </div>
  {recruitment && <RenewalRecruitCta event={recruitment} />}
</RenewalLayout>
