---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import RenewalImageLightbox from "../../components/renewal/RenewalImageLightbox.astro";
import RenewalFeaturePanel from "../../components/renewal/RenewalFeaturePanel.astro";
import RenewalActionLink from "../../components/renewal/RenewalActionLink.astro";
import RenewalHomeSchedule from "../../components/renewal/RenewalHomeSchedule.astro";
import {
  renewalApi,
  selectNextApplication,
  selectRecruitmentForBanner,
} from "../../lib/renewal-api";
import heroImage from "../../assets/renewal/素材_webp/しもたんギターギター.webp";
import heroBandImage from "../../assets/renewal/素材_webp/ギターギター.webp";
import heroAudienceImage from "../../assets/renewal/素材_webp/観客.webp";

const applications = await renewalApi.getApplication();
const nextLive = selectNextApplication(applications);
const recruitment = selectRecruitmentForBanner(applications);
---

<RenewalLayout
  home
  description="MuST（マスト）は、気の合う仲間と気軽にライブハウスで演奏できる東京都内の社会人軽音サークルです。"
>
  <div class="renewal-home" id="home">
    <section class="renewal-home__hero" aria-labelledby="home-title">
      <div class="renewal-home__hero-slideshow" aria-hidden="true">
        <img src={heroImage.src} alt="" />
        <img src={heroBandImage.src} alt="" />
        <img src={heroAudienceImage.src} alt="" />
      </div>
      <div class="renewal-home__hero-actions">
        <RenewalActionLink
          href="/renewal/application/"
          label="募集状況・申込み"
          variant="warm"
          icon="person"
        />
      </div>
      <div class="renewal-home__hero-copy">
        <h1 id="home-title">
          何歳になっても、
          <br />
          気の知れた仲間と、
          <br />
          気軽にライブハウスで演奏を。
        </h1>
        <p>
          MuSTは、そんな“居場所”を作りたくて始めた
          <br />
          社会人軽音サークルです。
        </p>
        <RenewalActionLink
          href="/renewal/overview/"
          label="MuSTについて詳しく見る"
          variant="primary"
        />
      </div>
    </section>

    <div class="renewal-home__content">
      <div class="renewal-home__feature-grid">
        <RenewalFeaturePanel
          variant="song"
          title="演奏曲について"
          icon="music"
          href="/renewal/setlist/"
          linkLabel="演奏曲について詳しく見る"
        >
          <Fragment slot="description">
            2017年以降のJ-POP・邦ロックを中心に、
            <br />
            話題のアーティストやフェスで盛り上がる
            <br />
            人気の曲を演奏します。
          </Fragment>
        </RenewalFeaturePanel>
        <RenewalFeaturePanel variant="activity" title="活動実績・過去のライブ" icon="chart">
          <Fragment slot="description">
            2023年の立ち上げから、ライブやセッションを
            <br />
            重ねてきました。
            <br />
            いつもの友人たちと、新しい出会いとともに。
            <br />
            10年後も、20年後も、その先も。
            <br />
            音楽を楽しむ時間を大切にしていきます。
          </Fragment>
          <Fragment slot="actions">
            <RenewalActionLink href="/renewal/history/" label="活動実績を見る" />
            <RenewalActionLink href="/renewal/setlist/" label="過去のライブを見る" />
          </Fragment>
        </RenewalFeaturePanel>
      </div>

      <RenewalHomeSchedule nextLive={nextLive} />
      {recruitment && <RenewalRecruitCta event={recruitment} />}
    </div>
  </div>
</RenewalLayout>

<RenewalImageLightbox label="チラシを拡大表示" />
