---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import RenewalImageLightbox from "../../components/renewal/RenewalImageLightbox.astro";
import RenewalFeaturePanel from "../../components/renewal/RenewalFeaturePanel.astro";
import RenewalActionLink from "../../components/renewal/RenewalActionLink.astro";
import RenewalHomeSchedule from "../../components/renewal/RenewalHomeSchedule.astro";
import homeHeroStyles from "./index.module.css";
import {
  getPageSettings,
  renewalApi,
  selectNextApplication,
  selectRecruitmentForBanner,
} from "../../lib/renewal-api";

const applications = await renewalApi.getApplication();
const homePageSettings = await getPageSettings("/");
const nextLive = selectNextApplication(applications);
const recruitment = selectRecruitmentForBanner(applications);
const homeHeroImages = homePageSettings?.hero_images ?? [];
const homeSubTitle = homePageSettings?.sub_title ?? "";
const homeDescription = homePageSettings?.description ?? "";
---

<RenewalLayout
  home
>
  <div class="renewal-home" id="home">
    <section class="renewal-home__hero" aria-labelledby="home-title">
      <div
        class={homeHeroStyles.slideshow}
        data-slide-count={homeHeroImages.length}
        aria-hidden="true"
      >
        {homeHeroImages.map((image, index) => (
          <img src={image.url} alt="" style={`--renewal-home-slide-index: ${index}`} />
        ))}
      </div>
      <div class="renewal-home__hero-actions">
        <RenewalActionLink
          href="/renewal/application/"
          label="募集状況・申込み"
          variant="warm"
          icon="person"
        />
      </div>
      <div class="renewal-home__hero-copy">
        <h1 id="home-title">
          {homeSubTitle.split("\n").map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </h1>
        <p>
          {homeDescription.split("\n").map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </p>
        <RenewalActionLink
          href="/renewal/overview/"
          label="MuSTについて詳しく見る"
          variant="primary"
        />
      </div>
    </section>

    <div class="renewal-home__content">
      <div class="renewal-home__feature-grid">
        <RenewalFeaturePanel
          variant="song"
          title="演奏曲について"
          icon="music"
          href="/renewal/music-selection/"
          linkLabel="演奏曲について詳しく見る"
        >
          <Fragment slot="description">
            <span data-renewal-home-music-year>—</span>年以降のJ-POP・邦ロックを中心に、
            <br />
            話題のアーティストやフェスで盛り上がる
            <br />
            人気の曲を演奏します。
          </Fragment>
        </RenewalFeaturePanel>
        <RenewalFeaturePanel variant="activity" title="活動実績・過去のライブ" icon="chart">
          <Fragment slot="description">
            2023年の立ち上げから、ライブやセッションを
            <br />
            重ねてきました。
            <br />
            いつもの友人たちと、新しい出会いとともに。
            <br />
            10年後も、20年後も、その先も。
            <br />
            音楽を楽しむ時間を大切にしていきます。
          </Fragment>
          <Fragment slot="actions">
            <RenewalActionLink href="/renewal/history/" label="活動実績を見る" />
            <RenewalActionLink href="/renewal/music-selection/" label="過去のライブを見る" />
          </Fragment>
        </RenewalFeaturePanel>
      </div>

      <RenewalHomeSchedule nextLive={nextLive} />
      {recruitment && <RenewalRecruitCta event={recruitment} />}
    </div>
  </div>
</RenewalLayout>

<RenewalImageLightbox label="チラシを拡大表示" />

<script>
  const homeMusicYear =
    Number(
      new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "Asia/Tokyo" }).format(
        new Date(),
      ),
    ) - 9;

  document.querySelectorAll("[data-renewal-home-music-year]").forEach((element) => {
    element.textContent = String(homeMusicYear);
  });
</script>
