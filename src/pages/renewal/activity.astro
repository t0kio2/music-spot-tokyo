---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import RenewalIcon from "../../components/renewal/RenewalIcon.astro";
import { renewalMockApi, summarizeActivities, selectRecruitmentForBanner, getEventTypeLabel, formatEventDate } from "../../lib/renewal-api";

const activities = await renewalMockApi.getActivities();
const applications = await renewalMockApi.getApplication();
const summary = summarizeActivities(activities);
const recruitment = selectRecruitmentForBanner(applications);
---

<RenewalLayout title="活動実績" description="MuSTのこれまでのライブ活動をご紹介します。">
	<div class="renewal-activity">
		<section class="renewal-activity__hero renewal-subpage-hero" aria-labelledby="activity-title">
			<RenewalBreadcrumb title="活動実績" className="renewal-activity__breadcrumb" />
			<h1 id="activity-title">活動実績</h1>
			<h2>これまでのライブで、<br />たくさんの仲間と音を重ねてきました。</h2>
			<p>MuSTは、2023年の立ち上げから現在まで、<br />さまざまな形式のライブを開催してきました。<br />これからも、音楽を通じて、もっと多くの人とつながっていきます。</p>
		</section>
		<section class="renewal-activity__stats" aria-label="活動実績の数字">
			<div class="renewal-activity__stat"><span><RenewalIcon name="music" /></span><div><b>開催ライブ</b><strong>{summary.live_count}<small>回</small></strong><em>（{new Date(summary.as_of_date).toLocaleDateString("ja-JP")}まで）</em></div></div>
			<div class="renewal-activity__stat"><span><RenewalIcon name="users" /></span><div><b>出演者延べ人数</b><strong>{summary.performer_count}<small>名</small></strong><em>（{new Date(summary.as_of_date).toLocaleDateString("ja-JP")}まで）</em></div></div>
			<p class="renewal-activity__note">音楽があるから、<br />もっと楽しくなる。</p>
		</section>
		<section class="renewal-activity__timeline" aria-labelledby="activity-history-title">
			<h2 id="activity-history-title">これまでの活動</h2>
			<div class="renewal-activity__years">
				{activities.map((item) => <article class="renewal-activity__year"><div class="renewal-activity__year-label"><strong>{item.year}</strong><span>{item.period_label}</span></div><div class="renewal-activity__year-copy"><b>{item.title}</b><ul>{item.details.map((detail) => <li>{detail.text}</li>)}</ul><p>出演者延べ人数 <strong>{item.performer_count}名</strong></p></div><div class="renewal-activity__year-photos" aria-label={`${item.year}年のライブ写真`}>{item.photos.map((photo) => <img src={photo.url} alt={photo.alt ?? ""} />)}</div></article>)}
			</div>
		</section>
		{recruitment && <section class="renewal-activity__next" aria-label="次回のライブ"><strong>Next Live</strong><p>{formatEventDate(recruitment.event_date)}　{getEventTypeLabel(recruitment.event_type)}<br />メンバーを募集中です。</p><a href={recruitment.application_url ?? "/renewal/application/"}>募集状況・申込み <span>→</span></a></section>}
	</div>
</RenewalLayout>
