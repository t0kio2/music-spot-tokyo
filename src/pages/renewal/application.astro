---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import { renewalMockApi, getEventTypeLabel, formatEventDate } from "../../lib/renewal-api";

const events = await renewalMockApi.getApplication();
---
<RenewalLayout title="募集状況・申込み" description="ライブの詳細や募集状況をご確認いただけます。">
	<div class="renewal-application">
		<section class="renewal-application__hero"><RenewalBreadcrumb title="募集状況・申込み" className="renewal-application__breadcrumb" /><h1>募集状況・申込み</h1><p>ライブの詳細や募集状況を確認して、ぜひご参加ください。</p></section>
		<section class="renewal-application__events" aria-label="募集中のライブイベント">
			{events.map((event, index) => <article class="renewal-application__event"><div class:list={["renewal-application__poster", { "renewal-application__poster--orange": index === 1 }]} style={event.cover_image ? `background-image: url(${event.cover_image.url})` : undefined} aria-hidden="true"></div><div class="renewal-application__info"><div class="renewal-application__title"><time>{event.event_date ? <><span>{new Date(event.event_date).getFullYear()}</span><b>{new Date(event.event_date).toLocaleDateString("ja-JP", { month: "numeric" })}</b></> : <b>未定</b>}</time><div><small>{getEventTypeLabel(event.event_type)}</small><h2>{event.title}</h2></div></div><dl><div><dt>▦</dt><dd><b>日時</b>{formatEventDate(event.event_date)}</dd></div>{event.place && <div><dt>●</dt><dd><b>会場</b>{event.place}</dd></div>}{event.fee && <div><dt>¥</dt><dd><b>費用</b>{event.fee}</dd></div>}</dl></div><div class="renewal-application__details">{event.parts.length > 0 && <><h3>募集パート</h3><ul>{event.parts.map((part) => <li>{part.part_name}　{part.status === "open" ? "募集中" : part.status === "waitlist" ? "キャンセル待ち" : "募集終了"}{part.note ? `（${part.note}）` : ""}</li>)}</ul></>}</div><aside class:list={["renewal-application__status", { "renewal-application__status--closed": event.is_closed }]}><h3>♙ 募集状況</h3><p>{event.status_message}</p><a href={event.application_url ?? "#apply"}>詳細を見る　→</a></aside></article>)}
		</section>
		<section class="renewal-application__apply" id="apply"><span aria-hidden="true">♙</span><h2>参加申込</h2><p>上記の各ライブへの参加をご希望の方は、こちらのフォームからお申し込みください。</p><a href="#apply">申込みフォームへ <span>→</span></a></section>
	</div>
</RenewalLayout>
