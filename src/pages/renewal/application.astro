---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../components/renewal/RenewalPageHero.astro";
import RenewalIcon from "../../components/renewal/RenewalIcon.astro";
import RenewalApplicationEvent from "../../components/renewal/RenewalApplicationEvent.astro";
import RenewalImageLightbox from "../../components/renewal/RenewalImageLightbox.astro";
import styles from "../../components/renewal/RenewalApplication.module.css";
import { renewalApi } from "../../lib/renewal-api";

const today = new Date();
today.setHours(0, 0, 0, 0);
const events = (await renewalApi.getApplication()).filter((event) => {
  if (!event.event_date) return true;
  const eventDate = new Date(event.event_date);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today;
});
---

<RenewalLayout>
  <div class:list={["renewal-application", styles.page]} id="top">
    <RenewalPageHero
      className="renewal-application__hero"
      compact
    />
    <section
      class:list={["renewal-application__events", styles.events]}
      aria-label="募集中のライブイベント"
    >
      {events.map((event) => (
        <RenewalApplicationEvent event={event} />
      ))}
    </section>
    <section class:list={["renewal-application__apply", styles.apply]} id="apply">
      <span class="renewal-application__apply-icon" aria-hidden="true">
        <RenewalIcon name="users" />
      </span>
      <h2>参加申込</h2>
      <p>上記の各ライブへの参加をご希望の方は、こちらのフォームからお申し込みください。</p>
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSf0yOb1Km58o-jxFF01zXR4FgyfiBkUHMU_nfsNCM44VwY_Ew/viewform"
        target="_blank"
        rel="noopener noreferrer"
      >
        申込みフォームへ <span>→</span>
      </a>
    </section>
  </div>
</RenewalLayout>

<RenewalImageLightbox label="チラシを拡大表示" />
