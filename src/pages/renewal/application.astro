---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import RenewalIcon from "../../components/renewal/RenewalIcon.astro";
import { renewalMockApi, formatEventDate } from "../../lib/renewal-api";

const events = await renewalMockApi.getApplication();
const typeLabels = ["対バンライブ", "定期ライブ", "企画セッション"];
const performers = ["Aoooコピー", "Official髭男dism・藤井風コピー", "ゲスの極み乙女。コピー", "Deco*27コピー", "星野源コピー"];
const parts = ["ボーカル", "ギター", "ベース", "ドラム", "キーボード", "トランペット", "トロンボーン", "サックス"];
---
<RenewalLayout title="募集状況・申込み" description="ライブの詳細や募集状況をご確認いただけます。">
	<div class="renewal-application" id="top">
		<section class="renewal-application__hero renewal-subpage-hero renewal-subpage-hero--compact"><RenewalBreadcrumb title="募集・申込み" className="renewal-application__breadcrumb" /><h1>募集状況・申込み</h1><p>ライブの詳細や募集状況を確認して、ぜひご参加ください。</p></section>
		<section class="renewal-application__events" aria-label="募集中のライブイベント">
			{events.map((event, index) => <article class:list={["renewal-application__event", { "renewal-application__event--compact": index === 2 }]}><div class:list={["renewal-application__poster", { "renewal-application__poster--orange": index === 1 }]} style={event.cover_image ? `background-image: linear-gradient(180deg, transparent 35%, rgba(0,0,0,.7)), url(${event.cover_image.url})` : undefined} role="img" aria-label="ライブステージ"></div><div class="renewal-application__info"><div class="renewal-application__title"><time><span>{event.event_date ? new Date(event.event_date).getFullYear() : ""}</span><b>{event.event_date ? `${new Date(event.event_date).getMonth() + 1}月` : "未定"}</b></time><div><small>{typeLabels[index]}</small><h2>{event.title}</h2></div></div>{index < 2 ? <dl class="renewal-application__details-list"><div><dt>▦</dt><dd><b>日時</b>{index === 0 ? "12/12(土)　10:00〜16:00" : formatEventDate(event.event_date)}</dd></div><div><dt>●</dt><dd><b>会場</b>{index === 0 ? "飯田橋 SPACE WITH" : event.place}</dd></div><div><dt>¥</dt><dd><b>費用</b>{index === 0 ? "1,500円（1D別）" : event.fee}</dd></div></dl> : <p class="renewal-application__undecided">日程・内容は未定です。</p>}</div>{index === 0 && <div class="renewal-application__roster"><h3>出演（演奏順は未定）</h3><ol>{performers.map((name, performerIndex) => <li><span>{performerIndex + 1}</span>{name}</li>)}</ol></div>}{index === 1 && <div class="renewal-application__schedule"><h3>選曲について</h3><p>10月中にリクエストやエントリーを行います。</p><h3>練習会</h3><p>▦　1/16(土)、2/13(土)　11:30〜17:30<br />●　スタジオノア初台店</p><h3>ライブ本番</h3><p>▦　3/13(土)　10:00〜16:00<br />●　大塚 welcome back<br />¥　2,600円前後（1D別）</p></div>}<aside class:list={["renewal-application__status", { "renewal-application__status--closed": index === 0 }]}><h3><span>{index === 0 ? "◎" : "♙"}</span>募集状況</h3>{index === 0 ? <p>観覧者のみの募集です。<br />出演者の募集は行なっておりません。</p> : index === 1 ? <><p>パートごとの募集状況</p><div class="renewal-application__vacancies">{parts.map((part, partIndex) => <span>♬ {part} <b class:list={{ "is-wait": partIndex === 2 || partIndex === 7 }}>{partIndex === 2 || partIndex === 7 ? "キャンセル待ち" : "募集中"}</b></span>)}</div></> : <p>内容が未定のため<br />まだ募集していません。</p>}</aside></article>)}
		</section>
		<section class="renewal-application__apply" id="apply"><span class="renewal-application__apply-icon" aria-hidden="true"><RenewalIcon name="users" /></span><h2>参加申込</h2><p>上記の各ライブへの参加をご希望の方は、こちらのフォームからお申し込みください。</p><a href="#apply">申込みフォームへ <span>→</span></a></section>
	</div>
</RenewalLayout>
