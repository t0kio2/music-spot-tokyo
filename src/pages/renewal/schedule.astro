---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../components/renewal/RenewalPageHero.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import {
  renewalApi,
  getEventTypeLabel,
  formatEventDate,
  selectRecruitmentForBanner,
} from "../../lib/renewal-api";
const applications = await renewalApi.getApplication();
const upcoming = applications
  .filter((event) => event.event_date && new Date(event.event_date).getTime() >= Date.now())
  .sort(
    (a, b) =>
      new Date(a.event_date as string).getTime() - new Date(b.event_date as string).getTime() ||
      a.sort_order - b.sort_order,
  );
const recruitment = selectRecruitmentForBanner(applications);
---

<RenewalLayout title="スケジュール" description="開催予定のライブ情報をご案内します。">
  <div class="renewal-schedule">
    <RenewalPageHero
      title="スケジュール"
      description="開催予定のライブ情報をご案内します。"
      className="renewal-schedule__hero"
    />
    <section class="renewal-schedule__content" aria-label="開催予定のライブ">
      <div class="renewal-schedule__heading">
        <p>Upcoming Live</p>
        <h2>これからのライブ</h2>
      </div>
      <div class="renewal-schedule__list">
        {upcoming.map((event) => (
          <article>
            <time datetime={event.event_date}>{formatEventDate(event.event_date)}</time>
            <div>
              <h3>{event.title}</h3>
              <p class="renewal-schedule__body">
                {getEventTypeLabel(event.event_type)}
                {event.place && ` / ${event.place}`}
                <br />
                {event.status_message}
              </p>
            </div>
            <a href={event.application_url ?? "/renewal/application/"}>募集状況を見る →</a>
          </article>
        ))}
        {upcoming.length === 0 && (
          <p class="renewal-empty">現在予定されているスケジュールはありません。</p>
        )}
      </div>
    </section>
    <section class="renewal-schedule__apply">
      <p>参加するライブが決まったら、募集状況をご確認ください。</p>
      <a href="/renewal/application/">
        募集状況・申込み <span>→</span>
      </a>
    </section>
    {recruitment && <RenewalRecruitCta event={recruitment} />}
  </div>
</RenewalLayout>
