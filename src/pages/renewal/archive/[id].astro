---
import RenewalLayout from "../../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../../components/renewal/RenewalPageHero.astro";
import RenewalIcon from "../../../components/renewal/RenewalIcon.astro";
import RenewalRecruitCta from "../../../components/renewal/RenewalRecruitCta.astro";
import "../../../components/renewal/RenewalArchiveDetail.css";
import {
  renewalApi,
  getEventTypeLabel,
  getYoutubeThumbnail,
  selectRecruitmentForBanner,
  type RenewalArchive,
} from "../../../lib/renewal-api";

export async function getStaticPaths() {
  const archives = await renewalApi.getArchives();
  return archives.map((archive) => ({ params: { id: archive.id }, props: { archive } }));
}

interface Props {
  archive: RenewalArchive;
}
const { archive } = Astro.props;
const recruitment = selectRecruitmentForBanner(await renewalApi.getApplication());
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    weekday: "short",
  });
---

<RenewalLayout
  useCmsContent={false}
  title={`${archive.title} 演奏曲`}
  description={`${archive.title}で演奏した曲をご紹介します。`}
>
  <div class="renewal-archive-detail">
    <RenewalPageHero
      title={archive.title}
      className="renewal-archive-detail__hero"
      breadcrumbTitle="演奏曲"
      parentTitle="過去のライブ"
      parentHref="/renewal/archive/"
      id="archive-title"
      compact
      useCmsContent={false}
      style={`--renewal-archive-detail-image: url("${archive.cover_image.url}")`}
    >
      <p slot="eyebrow" class="renewal-archive-detail__eyebrow">
        {formatDate(archive.event_date)} {getEventTypeLabel(archive.event_type)}
      </p>
      <p class="renewal-archive-detail__place">
        <RenewalIcon name="pin" />
        {archive.place}
      </p>
    </RenewalPageHero>
    <main class="renewal-archive-detail__content">
      <div class="renewal-archive-detail__heading">
        <h2>演奏曲</h2>
      </div>
      {archive.setlist.length > 0 ? (
        <ol class="renewal-archive-detail__setlist">
          {archive.setlist.map((song, index) => (
            <li class:list={{ "has-video": Boolean(song.youtube_url) }}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <b>{song.song_title}</b>
                <small>{song.artist}</small>
              </div>
              {song.youtube_url && (
                <a
                  class="renewal-archive-detail__thumbnail"
                  href={song.youtube_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${song.song_title}の演奏動画`}
                >
                  {getYoutubeThumbnail(song.youtube_url) && (
                    <img src={getYoutubeThumbnail(song.youtube_url)} alt="" />
                  )}
                  <i aria-hidden="true">▶</i>
                </a>
              )}
            </li>
          ))}
        </ol>
      ) : (
        <p class="renewal-archive-detail__empty">演奏曲は準備中です。</p>
      )}
    </main>
    {recruitment && <RenewalRecruitCta event={recruitment} />}
  </div>
</RenewalLayout>
