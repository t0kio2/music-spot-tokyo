---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalPageHero from "../../components/renewal/RenewalPageHero.astro";
import RenewalMusicGenreCards from "../../components/renewal/RenewalMusicGenreCards.astro";
import RenewalMusicInfoCards from "../../components/renewal/RenewalMusicInfoCards.astro";
import RenewalMusicSelectionGuide from "../../components/renewal/RenewalMusicSelectionGuide.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import { renewalApi, selectRecruitmentForBanner } from "../../lib/renewal-api";

const recruitment = selectRecruitmentForBanner(await renewalApi.getApplication());
---

<RenewalLayout>
  <div class="renewal-setlist">
    <RenewalPageHero
      className="renewal-setlist__hero"
      id="setlist-title"
      compact
    />

    <section class="renewal-setlist__content">
      <RenewalMusicGenreCards />

      <RenewalMusicSelectionGuide />

      <RenewalMusicInfoCards />
    </section>
    {recruitment && <RenewalRecruitCta event={recruitment} />}
  </div>
</RenewalLayout>
