---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import RenewalIcon from "../../components/renewal/RenewalIcon.astro";
import { renewalMockApi, getEventTypeLabel } from "../../lib/renewal-api";

const archives = await renewalMockApi.getArchives();
const formatDate = (date: string) => new Date(date).toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric", weekday: "short" });
---

<RenewalLayout title="過去のライブ" description="これまで開催したライブの記録をご紹介します。">
	<div class="renewal-archive">
		<section class="renewal-archive__hero" aria-labelledby="archive-title">
			<RenewalBreadcrumb title="過去のライブ" className="renewal-archive__breadcrumb" />
			<h1 id="archive-title">過去のライブ</h1>
			<p>これまで開催したライブの記録をご紹介します。</p>
		</section>
		<nav class="renewal-archive__filters" aria-label="ライブ開催年で絞り込み">
			{["all", "2026", "2025", "2024", "2023"].map((year, index) => <button type="button" class:list={{ active: index === 0 }} data-year={year} aria-pressed={index === 0 ? "true" : "false"}>{year === "all" ? "すべて" : year}</button>)}
		</nav>
		<section class="renewal-archive__grid" aria-label="過去のライブ一覧">
			{archives.map((live) => <article class="renewal-archive__card" data-year={live.event_date.slice(0, 4)}><img src={live.cover_image.url} alt={live.cover_image.alt ?? `${live.title}のライブ写真`} /><div class="renewal-archive__details"><div class="renewal-archive__meta"><span>{new Date(live.event_date).toLocaleDateString("ja-JP", { year: "numeric", month: "long" })}</span><b class:list={{ pink: live.event_type === "band" }}>{getEventTypeLabel(live.event_type)}</b></div><h2>{live.title}</h2>{live.subtitle && <p class="renewal-archive__subtitle">{live.subtitle}</p>}<p class="renewal-archive__line"><RenewalIcon name="calendar" />{formatDate(live.event_date)}　{live.event_time}</p><p class="renewal-archive__line"><RenewalIcon name="pin" />{live.place}</p><div class="renewal-archive__numbers">{[["出演者", live.performer_count], ["観覧者", live.audience_count], ["合計", live.total_count]].map(([label, count]) => <span>{label}<strong>{count}名</strong></span>)}</div><a class="renewal-archive__video" href={live.youtube_url ?? "#video"}><span>▶</span>演奏動画をみる（YouTube）<b>→</b></a></div></article>)}
		</section>
		<button class="renewal-archive__more" type="button">さらに過去のライブを見る <span>→</span></button>
	</div>
</RenewalLayout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>(".renewal-archive__filters button");
	const cards = document.querySelectorAll<HTMLElement>(".renewal-archive__card");
	filters.forEach((filter) => filter.addEventListener("click", () => {
		const year = filter.dataset.year;
		filters.forEach((button) => { const active = button === filter; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
		cards.forEach((card) => { card.hidden = card.classList.contains("renewal-archive__card--extra") || (year !== "all" && card.dataset.year !== year); });
	}));
	document.querySelector<HTMLButtonElement>(".renewal-archive__more")?.addEventListener("click", (event) => {
		document.querySelectorAll<HTMLElement>(".renewal-archive__card--extra").forEach((card) => { card.hidden = false; });
		(event.currentTarget as HTMLButtonElement).hidden = true;
	});
</script>
