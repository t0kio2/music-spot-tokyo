---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalBreadcrumb from "../../components/renewal/RenewalBreadcrumb.astro";
import RenewalIcon from "../../components/renewal/RenewalIcon.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import RenewalImageLightbox from "../../components/renewal/RenewalImageLightbox.astro";
import { renewalApi, getEventTypeLabel, selectRecruitmentForBanner } from "../../lib/renewal-api";

const archives = await renewalApi.getArchives();
const recruitment = selectRecruitmentForBanner(await renewalApi.getApplication());
const formatDate = (date: string) => new Date(date).toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric", weekday: "short" });
const years = [...new Set(archives.map((live) => live.event_date.slice(0, 4)))].sort((a, b) => Number(b) - Number(a));
const archivePageSize = 6;
---

<RenewalLayout title="過去のライブ" description="これまで開催したライブの記録をご紹介します。">
	<div class="renewal-archive">
		<section class="renewal-archive__hero renewal-subpage-hero renewal-subpage-hero--compact" aria-labelledby="archive-title">
			<RenewalBreadcrumb title="過去のライブ" className="renewal-archive__breadcrumb" />
			<h1 id="archive-title">過去のライブ</h1>
			<p>これまで開催したライブの記録をご紹介します。</p>
		</section>
		<nav class="renewal-archive__filters" aria-label="ライブ開催年で絞り込み">
			{["all", ...years].map((year, index) => <button type="button" class:list={{ active: index === 0 }} data-year={year} aria-pressed={index === 0 ? "true" : "false"}>{year === "all" ? "すべて" : year}</button>)}
		</nav>
		<section class="renewal-archive__grid" aria-label="過去のライブ一覧">
			{archives.map((live, index) => <article class:list={["renewal-archive__card", { "renewal-archive__card--extra": index >= archivePageSize }]} hidden={index >= archivePageSize} data-year={live.event_date.slice(0, 4)}><button class="renewal-archive__photo" type="button" data-renewal-lightbox-src={live.cover_image.url} aria-label={`${live.title}のライブ写真を拡大表示`}><img src={live.cover_image.url} alt={live.cover_image.alt ?? `${live.title}のライブ写真`} /></button><div class="renewal-archive__details"><div class="renewal-archive__meta"><span>{new Date(live.event_date).toLocaleDateString("ja-JP", { year: "numeric", month: "long" })}</span><b class:list={{ pink: live.event_type === "band" }}>{getEventTypeLabel(live.event_type)}</b></div><h2>{live.title}</h2>{live.subtitle && <p class="renewal-archive__subtitle">{live.subtitle}</p>}<p class="renewal-archive__line"><RenewalIcon name="calendar" />{formatDate(live.event_date)}　{live.event_time}</p><p class="renewal-archive__line"><RenewalIcon name="pin" />{live.place}</p><div class="renewal-archive__numbers">{[["出演者", live.performer_count], ["観覧者", live.audience_count], ["合計", live.total_count]].map(([label, count]) => <span>{label}<strong>{count}名</strong></span>)}</div><div class="renewal-archive__actions">{live.setlist.length > 0 && <a class="renewal-archive__setlist" href={`/renewal/archive/${live.id}/`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"/><path class="renewal-archive__youtube-play" d="m9.6 8.5 6.3 3.5-6.3 3.5Z"/></svg><span>演奏曲を見る</span> <b>→</b></a>}{live.youtube_url && <a class="renewal-archive__video" href={live.youtube_url} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"/><path class="renewal-archive__youtube-play" d="m9.6 8.5 6.3 3.5-6.3 3.5Z"/></svg>演奏動画を見る <b>→</b></a>}</div></div></article>)}
		</section>
		{archives.length > archivePageSize && <button class="renewal-archive__more" type="button">さらに過去のライブを見る <span>→</span></button>}
		{recruitment && <RenewalRecruitCta event={recruitment} />}
	</div>
</RenewalLayout>

<RenewalImageLightbox label="ライブ写真を拡大表示" />

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>(".renewal-archive__filters button");
	const cards = document.querySelectorAll<HTMLElement>(".renewal-archive__card");
	const moreButton = document.querySelector<HTMLButtonElement>(".renewal-archive__more");
	let showAll = false;
	const applyFilter = (year = "all") => {
		cards.forEach((card) => { card.hidden = (!showAll && card.classList.contains("renewal-archive__card--extra")) || (year !== "all" && card.dataset.year !== year); });
	};
	filters.forEach((filter) => filter.addEventListener("click", () => {
		const year = filter.dataset.year;
		filters.forEach((button) => { const active = button === filter; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
		showAll = false;
		if (moreButton) moreButton.hidden = false;
		applyFilter(year);
	}));
	moreButton?.addEventListener("click", () => {
		showAll = true;
		applyFilter(document.querySelector<HTMLButtonElement>(".renewal-archive__filters button.active")?.dataset.year);
		moreButton.hidden = true;
	});

</script>
