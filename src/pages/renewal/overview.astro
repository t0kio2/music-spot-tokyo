---
import RenewalLayout from "../../layouts/RenewalLayout.astro";
import RenewalOverviewHero from "../../components/renewal/RenewalOverviewHero.astro";
import RenewalOverviewStats from "../../components/renewal/RenewalOverviewStats.astro";
import RenewalOverviewFeatures from "../../components/renewal/RenewalOverviewFeatures.astro";
import RenewalRecruitCta from "../../components/renewal/RenewalRecruitCta.astro";
import { renewalApi, selectRecruitmentForBanner } from "../../lib/renewal-api";

const overview = await renewalApi.getOverview();
const applications = await renewalApi.getApplication();
const recruitment = selectRecruitmentForBanner(applications);
---

<RenewalLayout>
  <div class="renewal-overview">
    <RenewalOverviewHero />
    <RenewalOverviewStats
      items={[
        { icon: "pin", label: "活動場所", value: "東京23区内" },
        {
          icon: "users",
          label: "参加人数",
          value: overview.participant_count,
          suffix: `名（女性${overview.female_count}名・男性${overview.male_count}名）`,
          date: overview.participant_as_of,
          large: true,
        },
      ]}
    />

    <section class="renewal-overview__content" id="activities" aria-label="MuSTの特徴">
      <RenewalOverviewFeatures />
    </section>

    {recruitment && <RenewalRecruitCta event={recruitment} />}
  </div>
</RenewalLayout>
