---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug } from "../lib/microcms";

const page = await getPageBySlug("home");
---

<Layout description="MuST（マスト）は、「気軽」に「気の合う仲間」とライブハウスで演奏できる、東京都内の社会人軽音セッションサークルです。「久しぶりにライブに出たい」「音楽を通じて同世代の友達を作りたい」「初心者・ライブ未経験だけどステージに立ってみたい」という方々、ぜひお気軽にご参加ください！">
	<div class="container home prose" set:html={page?.content ?? ""} />
</Layout>

<style>
	.home {
		padding-top: 1rem;
	}

	.home :global(figure) {
		max-width: none;
	}

	.home :global(figure img) {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: calc(100svh - 8rem);
		margin-inline: auto;
	}
</style>
