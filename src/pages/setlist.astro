---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, getScheduleAndArchive } from "../lib/microcms";

const [page, data] = await Promise.all([getPageBySlug("setlist"), getScheduleAndArchive()]);

const now = new Date();
const past = data.schedules
	.filter((s) => new Date(s.event_date) < now)
	.sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "Asia/Tokyo",
});
---

<Layout title={page?.title ?? "演奏曲について"}>
	<h1 class="prose-title">{page?.title ?? "演奏曲について"}</h1>

	<section class="section intro-links">
		<div class="container">
			<a href={data.past_songs_url} target="_blank" rel="noopener noreferrer" class="link">
				選曲目安・過去の演奏曲一覧等
			</a>
			<a href={data.youtube_url} target="_blank" rel="noopener noreferrer" class="link">
				演奏動画のリンク
			</a>
		</div>
	</section>

	<section class="section">
		<h2 class="section-title">過去のライブの詳細</h2>
		<div class="container live-list">
			{
				past.map((ev) => (
					<article class="live-card">
						<p class="eyebrow">{dateFormatter.format(new Date(ev.event_date))}</p>
						<h3>{ev.title}</h3>
						<div class="prose" set:html={ev.content} />
					</article>
				))
			}
			{past.length === 0 && <p class="empty">過去のライブ情報はまだありません。</p>}
		</div>
	</section>
</Layout>

<style>
	.prose-title {
		text-align: center;
		font-size: 1.9rem;
		margin: 1rem 0 2rem;
	}

	.intro-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: center;
		padding-bottom: 1rem;
	}

	.intro-links .container {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.live-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.live-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.5rem 1.75rem;
	}

	.live-card h3 {
		font-size: 1.05rem;
		margin: 0.3rem 0 0.75rem;
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 780px) {
		.live-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.prose-title {
			font-size: 1.4rem;
		}
	}
</style>
