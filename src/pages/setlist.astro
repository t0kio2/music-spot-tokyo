---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, getScheduleAndArchive } from "../lib/microcms";

const [page, data] = await Promise.all([getPageBySlug("setlist"), getScheduleAndArchive()]);

const now = new Date();
const past = data.schedules
	.filter((s) => new Date(s.event_date) < now)
	.sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());
---

<Layout
	title={page?.title ?? "演奏曲について"}
	description="社会人軽音サークルMuST（マスト）の選曲目安や過去の演奏曲、ライブ情報をご紹介します。演奏動画へのリンクも掲載していますので、活動の雰囲気をご覧ください。"
>
	<h1 class="prose-title">{page?.title ?? "演奏曲について"}</h1>

	<section class="section intro-links">
		<div class="container">
			<a href={data.past_songs_url} target="_blank" rel="noopener noreferrer" class="link">
				選曲目安・過去の演奏曲一覧等
			</a>
			<a href={data.youtube_url} target="_blank" rel="noopener noreferrer" class="link">
				演奏動画のリンク
			</a>
		</div>
	</section>

	<section class="section">
		<h2 class="section-title">過去のライブの詳細</h2>
		<div class="container live-list">
			{
				past.map((ev) => (
					<details class="live-item">
						<summary>{ev.title}</summary>
						<div class="prose live-content" set:html={ev.content} />
					</details>
				))
			}
			{past.length === 0 && <p class="empty">過去のライブ情報はまだありません。</p>}
		</div>
	</section>
</Layout>

<style>
	.prose-title {
		text-align: center;
		font-size: 1.9rem;
		margin: 1rem 0 2rem;
	}

	.intro-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: center;
		padding-bottom: 1rem;
	}

	.intro-links .container {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.live-list {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.live-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.1rem 1.5rem;
		interpolate-size: allow-keywords;
	}

	.live-item::details-content {
		block-size: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			block-size 0.3s ease,
			opacity 0.2s ease,
			content-visibility 0.3s allow-discrete;
	}

	.live-item[open]::details-content {
		block-size: auto;
		opacity: 1;
	}

	.live-item summary {
		cursor: pointer;
		font-weight: 600;
		display: flex;
		align-items: baseline;
		list-style: none;
	}

	.live-item summary::-webkit-details-marker {
		display: none;
	}

	.live-item summary::after {
		content: "+";
		margin-left: auto;
		color: var(--color-accent);
		font-size: 1.2rem;
	}

	.live-item[open] summary::after {
		content: "−";
	}

	.live-content {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px dashed var(--color-border);
		font-size: 0.92rem;
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.prose-title {
			font-size: 1.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live-item::details-content {
			transition: none;
		}
	}
</style>
