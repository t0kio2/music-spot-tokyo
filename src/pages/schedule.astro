---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, getScheduleAndArchive } from "../lib/microcms";

const [page, data] = await Promise.all([getPageBySlug("schedule"), getScheduleAndArchive()]);

const now = new Date();
const upcoming = data.schedules
	.filter((s) => new Date(s.event_date) >= now)
	.sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "Asia/Tokyo",
});
---

<Layout title={page?.title ?? "スケジュール"}>
	<h1 class="prose-title">{page?.title ?? "スケジュール"}</h1>

	<section class="section">
		<div class="container event-list">
			{
				upcoming.map((ev) => (
					<article class="event-card">
						<p class="eyebrow">{dateFormatter.format(new Date(ev.event_date))}</p>
						<h2>{ev.title}</h2>
						<div class="prose" set:html={ev.content} />
					</article>
				))
			}
			{upcoming.length === 0 && <p class="empty">現在予定されているスケジュールはありません。</p>}
		</div>
	</section>
</Layout>

<style>
	.prose-title {
		text-align: center;
		font-size: 1.9rem;
		margin: 1rem 0 2rem;
	}

	.event-list {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.event-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 2rem;
	}

	.event-card h2 {
		font-size: 1.3rem;
		margin: 0.3rem 0 1.25rem;
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.prose-title {
			font-size: 1.4rem;
		}
	}
</style>
