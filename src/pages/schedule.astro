---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import {
  Api,
  getEventTypeLabel,
  formatEventDate,
  getDateValue,
  getToday,
} from "../lib/api";
const applications = await Api.getApplication();
const today = getToday().getTime();
const upcoming = applications
  .filter(
    (event) =>
      event.event_date && getDateValue(event.event_date) >= today,
  )
  .sort(
    (a, b) =>
      getDateValue(a.event_date as string) - getDateValue(b.event_date as string) ||
      a.sort_order - b.sort_order,
  );
---

<Layout>
  <div class="schedule">
    <PageHero
      className="schedule__hero"
    />
    <section class="schedule__content" aria-label="開催予定のライブ">
      <div class="schedule__heading">
        <p>Upcoming Live</p>
        <h2>これからのライブ</h2>
      </div>
      <div class="schedule__list">
        {upcoming.map((event) => (
          <article>
            <time datetime={event.event_date}>{formatEventDate(event.event_date)}</time>
            <div>
              <h3>{event.title}</h3>
              <p class="schedule__body">
                {getEventTypeLabel(event.event_type)}
                {event.place && ` / ${event.place}`}
                <br />
                {event.status_message}
              </p>
            </div>
            <a href={event.application_url ?? "/application/"}>募集状況を見る →</a>
          </article>
        ))}
        {upcoming.length === 0 && (
          <p class="empty">現在予定されているスケジュールはありません。</p>
        )}
      </div>
    </section>
    <section class="schedule__apply">
      <p>参加するライブが決まったら、募集状況をご確認ください。</p>
      <a href="/application/">
        募集状況・申込み <span>→</span>
      </a>
    </section>
  </div>
</Layout>
