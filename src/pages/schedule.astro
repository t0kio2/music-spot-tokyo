---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, getScheduleAndArchive } from "../lib/microcms";

const [page, data] = await Promise.all([getPageBySlug("schedule"), getScheduleAndArchive()]);

const now = new Date();
const upcoming = data.schedules
	.filter((s) => new Date(s.event_date) >= now)
	.sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());
---

<Layout title={page?.title ?? "スケジュール"}>
	<h1 class="prose-title">{page?.title ?? "スケジュール"}</h1>

	<section class="section">
		<div class="container event-list">
			{
				upcoming.map((ev, i) => (
					<details class="schedule-item" open={i === 0}>
						<summary>{ev.title}</summary>
						<div class="prose schedule-content" set:html={ev.content} />
					</details>
				))
			}
			{upcoming.length === 0 && <p class="empty">現在予定されているスケジュールはありません。</p>}
		</div>
	</section>
</Layout>

<style>
	.prose-title {
		text-align: center;
		font-size: 1.9rem;
		margin: 1rem 0 2rem;
	}

	.event-list {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.schedule-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.1rem 1.5rem;
		interpolate-size: allow-keywords;
	}

	.schedule-item::details-content {
		block-size: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			block-size 0.3s ease,
			opacity 0.2s ease,
			content-visibility 0.3s allow-discrete;
	}

	.schedule-item[open]::details-content {
		block-size: auto;
		opacity: 1;
	}

	.schedule-item summary {
		cursor: pointer;
		font-weight: 600;
		display: flex;
		align-items: baseline;
		list-style: none;
	}

	.schedule-item summary::-webkit-details-marker {
		display: none;
	}

	.schedule-item summary::after {
		content: "+";
		margin-left: auto;
		color: var(--color-accent);
		font-size: 1.2rem;
	}

	.schedule-item[open] summary::after {
		content: "−";
	}

	.schedule-content {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px dashed var(--color-border);
		font-size: 0.92rem;
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.prose-title {
			font-size: 1.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.schedule-item::details-content {
			transition: none;
		}
	}
</style>
