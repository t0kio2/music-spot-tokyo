---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FlowSteps from "../components/FlowSteps.astro";
const steps = [
  [
    "１",
    "document",
    "参加申込",
    "本サイト内の「募集状況・申込み」から必要事項を入力しご応募ください。",
    "",
  ],
  ["２", "warning", "注意事項の確認", "当サークルの注意事項について、ご確認いただきます。", ""],
  [
    "３",
    "line",
    "LINEグループ招待",
    "参加希望のライブのLINEグループに招待させていただきます。（LINEグループはライブ毎に作成しております。）",
    "",
  ],
  [
    "４",
    "music",
    "希望曲のリクエスト",
    "募集期間に希望曲をリクエストします。その後、運営者が選曲します。",
    "※企画ライブは企画内容によります。",
  ],
  [
    "５",
    "document",
    "出演曲のエントリー",
    "エントリー期間になったら、演奏したい曲にエントリーします。",
    "",
  ],
  [
    "６",
    "guitar",
    "各自、自主練習",
    "練習会や本番まで各自、トレーニングに励んでください。自主練習期間は２か月ほどございます。",
    "",
  ],
  [
    "７",
    "users",
    "練習会",
    "スタジオにて練習会を行います。費用は1,000円〜1,500円。練習会は２回行います。",
    "定期セッションライブのみ",
  ],
  ["８", "stage", "ライブ本番", "ライブ本番です。大いに楽しみましょう。", ""],
];
---

<Layout>
  <div class="flow">
    <PageHero
      className="flow__hero"
      compact
    />
    <FlowSteps
      mobileOnlyAccordion
      steps={steps.map(([number, icon, title, text, note]) => ({
        number,
        icon,
        title,
        text,
        note,
      }))}
    />
  </div>
</Layout>
