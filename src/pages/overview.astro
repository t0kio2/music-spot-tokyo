---
import Layout from "../layouts/Layout.astro";
import OverviewHero from "../components/OverviewHero.astro";
import OverviewStats from "../components/OverviewStats.astro";
import OverviewFeatures from "../components/OverviewFeatures.astro";
import { Api } from "../lib/api";

const overview = await Api.getOverview();
---

<Layout>
  <div class="overview">
    <OverviewHero />
    <OverviewStats
      items={[
        { icon: "pin", label: "活動場所", value: "東京都内" },
        {
          icon: "users",
          label: "参加人数",
          value: overview.participant_count,
          suffix: `名（女性${overview.female_count}名・男性${overview.male_count}名）`,
          date: "today",
          large: true,
        },
      ]}
    />

    <section class="overview__content" id="activities" aria-label="MuSTの特徴">
      <OverviewFeatures />
    </section>

  </div>
</Layout>
