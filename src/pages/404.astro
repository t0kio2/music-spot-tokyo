---
import Layout from "../layouts/Layout.astro";
import ActionLink from "../components/ActionLink.astro";
---

<Layout title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__content">
      <p class="not-found__code" aria-hidden="true">
        404
      </p>
      <h1 id="not-found-title">ページが見つかりません</h1>
      <p class="not-found__message">
        お探しのページは、移動または削除された可能性があります。
      </p>
      <ActionLink href="/" label="MuSTのホームへ戻る" variant="primary" />
    </div>
  </section>
</Layout>
