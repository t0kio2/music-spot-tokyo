---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug } from "../lib/microcms";

const page = await getPageBySlug("application");

---

<Layout
	title={page?.title ?? "募集状況・申込み"}
	description="社会人軽音サークルMuST（マスト）の募集状況・参加申込みのご案内です。東京都内で音楽仲間を探している方は、募集内容をご確認のうえ、こちらからお申し込みください。"
>
	<section class="section">
		<div class="container prose" set:html={page?.content ?? ""} />
	</section>
</Layout>

<style>
	.apply-form {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.apply-form label {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-ink);
	}

	.apply-form input[type="text"],
	.apply-form textarea {
		font: inherit;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 0.65rem 0.85rem;
		font-weight: 400;
	}

	.apply-form fieldset {
		border: none;
		padding: 0;
		margin: 0;
	}

	.apply-form legend {
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 0.6rem;
		padding: 0;
	}

	.checkbox-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
	}

	.checkbox {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 400;
		font-size: 0.88rem;
	}

	.submit {
		align-self: flex-start;
	}

	.form-note {
		font-size: 0.8rem;
		color: var(--color-muted);
	}

	@media (max-width: 780px) {
		.checkbox-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
