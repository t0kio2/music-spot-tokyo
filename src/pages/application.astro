---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug } from "../lib/microcms";

const page = await getPageBySlug("application");

const partOptions = [
	"ボーカル",
	"ギター",
	"ベース",
	"ドラム",
	"キーボード",
	"トランペット",
	"トロンボーン",
	"アルト・テナーサックス",
];

const sourceOptions = [
	"Instagram",
	"X（旧Twitter）",
	"ジモティー",
	"ROCK/JOINT",
	"サークルブック",
	"知人の紹介等",
	"YouTube",
	"バンオフ",
];
---

<Layout title={page?.title ?? "募集状況・申込み"}>
	<section class="section">
		<div class="container prose" set:html={page?.content ?? ""} />
	</section>

	<section class="section">
		<h2 class="section-title">応募フォーム</h2>
		<p class="section-sub">
			応募前にLINE設定「IDによる友達追加を許可」がONになっているか必ずお確かめください。
		</p>
		<div class="container">
			<form class="apply-form card">
				<label>
					お名前
					<input type="text" name="name" required />
				</label>

				<label>
					LINE ID
					<input type="text" name="line-id" required />
				</label>

				<fieldset>
					<legend>希望パート</legend>
					<div class="checkbox-grid">
						{
							partOptions.map((p) => (
								<label class="checkbox">
									<input type="checkbox" name="part" value={p} />
									{p}
								</label>
							))
						}
					</div>
				</fieldset>

				<label>
					生まれ年、参加希望のライブを記載してください
					<textarea name="details" rows="3" required></textarea>
				</label>

				<fieldset>
					<legend>当サークルを知ったきっかけ</legend>
					<div class="checkbox-grid">
						{
							sourceOptions.map((s) => (
								<label class="checkbox">
									<input type="radio" name="source" value={s} />
									{s}
								</label>
							))
						}
					</div>
				</fieldset>

				<button type="submit" class="btn btn-primary submit">送信</button>
				<p class="form-note">
					参加希望のご連絡があった方には参加するライブ毎のLINEグループに招待させていただきます。
				</p>
			</form>
		</div>
	</section>
</Layout>

<style>
	.apply-form {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.apply-form label {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-ink);
	}

	.apply-form input[type="text"],
	.apply-form textarea {
		font: inherit;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 0.65rem 0.85rem;
		font-weight: 400;
	}

	.apply-form fieldset {
		border: none;
		padding: 0;
		margin: 0;
	}

	.apply-form legend {
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 0.6rem;
		padding: 0;
	}

	.checkbox-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
	}

	.checkbox {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 400;
		font-size: 0.88rem;
	}

	.submit {
		align-self: flex-start;
	}

	.form-note {
		font-size: 0.8rem;
		color: var(--color-muted);
	}

	@media (max-width: 780px) {
		.checkbox-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
