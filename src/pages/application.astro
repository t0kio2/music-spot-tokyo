---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import ApplicationEvent from "../components/ApplicationEvent.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import styles from "../components/Application.module.css";
import { getDateValue, getToday, Api } from "../lib/api";
import { APPLICATION_FORM_URL } from "../lib/links";

const today = getToday();
const events = (await Api.getApplication()).filter((event) => {
  if (!event.event_date) return true;
  return getDateValue(event.event_date) >= today.getTime();
});
---

<Layout>
  <div class:list={["application", styles.page]} id="top">
    <PageHero
      className="application__hero"
      compact
    />
    <section
      class:list={["application__events", styles.events]}
      aria-label="募集中のライブイベント"
    >
      {events.map((event) => (
        <ApplicationEvent event={event} />
      ))}
    </section>
    <section class:list={["application__apply", styles.apply]} id="apply">
      <span class="application__apply-icon" aria-hidden="true">
        <Icon name="users" />
      </span>
      <h2>参加申込</h2>
      <p>上記の各ライブへの参加をご希望の方は、こちらのフォームからお申し込みください。</p>
      <a
        href={APPLICATION_FORM_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        申込みフォームへ <span>→</span>
      </a>
    </section>
  </div>
</Layout>

<ImageLightbox label="チラシを拡大表示" />
