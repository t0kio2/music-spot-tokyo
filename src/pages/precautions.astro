---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import GuitarIcon from "../components/GuitarIcon.astro";
const sections = [
  {
    icon: "users",
    title: "サークル全般について",
    items: [
      "参加者間でトラブルが発生した際は当事者同士での解決をお願いします。",
      "練習会、ライブ本番における貴重品や機材等の管理は各自でお願いします。",
      "ライブ・練習会の様子を撮影し、各種SNSやYouTube、当HPにアップさせていただきますのでご容赦ください。",
      "応募いただいた内容に虚偽があった場合や、他の参加者を不快にさせる言動が多い方、運営上支障があると判断した方は、参加をお断りすることがございます。",
      "招待されたLINEグループでは、返信、投稿をしないでください。ご質問等がある場合は、運営者の個人LINEにご連絡お願いします。",
      "曲のエントリー後に出演を辞退される場合は、以下のキャンセル料金が発生しますのでご注意ください。",
    ],
  },
  {
    icon: "guitar",
    title: "練習会について",
    note: "（３月・９月の定期ライブのみ）",
    items: [
      "練習会には極力参加くださるようお願いします。欠席された場合は次回参加の際、制限事項がございます。",
      "第１回、第２回ともに同じ時間割となります。各自、スケジュールの調整をお願いします。",
      "スタジオ代は参加者の割り勘となります。1,000円〜1,500円程度です。",
      "やむを得ず欠席する場合は練習会の14日前までにご連絡をお願いいたします。",
    ],
  },
  {
    icon: "⊘",
    title: "勧誘行為の禁止",
    items: [
      "他サークル、他イベントへの勧誘行為",
      "主催者に無断でサークル内のメンバーとバンドを結成すること",
      "退会したメンバーからの勧誘を受け、他サークルや他イベントへ参加すること。",
    ],
  },
  {
    icon: "♬",
    title: "ライブについて",
    items: [
      "ライブ直前や当日のドタキャンはしないようお願いします。",
      "本番直前で欠員が出てしまった場合、欠員パート無しでの演奏か、出演代行を依頼するか、曲の中止となる場合がございます。",
      "ボーカルの方について、スマホや楽譜を見ながら歌うのはご遠慮ください。（代行出演の方は除く。）",
    ],
  },
];
---

<Layout>
  <div class="precautions">
    <PageHero
      className="precautions__hero"
      compact
    />
    <section class="precautions__content" id="notice" aria-label="サークルの注意事項">
      {sections.map((section, index) => (
        <details
          class:list={[
            "precautions__panel",
          ]}
        >
          <summary>
            <span>
              {section.icon === "users" ? (
                <Icon name="users" />
              ) : section.icon === "guitar" ? (
                <GuitarIcon className="precautions__guitar-icon" />
              ) : (
                section.icon
              )}
            </span>
            <h2>
              {section.title}
              <small>{section.note}</small>
            </h2>
            <i>＋</i>
          </summary>
          {section.title === "勧誘行為の禁止" && (
            <p class="precautions__intro">以下の行為を禁止します。</p>
          )}
          <ol>
            {section.items.map((item) => (
              <li>
                <b>{item}</b>
              </li>
            ))}
          </ol>
          {index === 0 && (
            <div class="precautions__fee">
      キャンセル料金：本番２か月以内は出演料の50%、１か月以内は出演料の100%（100円未満切り上げ）
            </div>
          )}
        </details>
      ))}
    </section>
  </div>
</Layout>
