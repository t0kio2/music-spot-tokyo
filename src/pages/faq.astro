---
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, getFaqList } from "../lib/microcms";

const [page, faqs] = await Promise.all([getPageBySlug("faq"), getFaqList()]);
---

<Layout
	title={page?.title ?? "よくある質問"}
	description="社会人軽音サークルMuST（マスト）によく寄せられる質問と回答をまとめています。活動や参加についての疑問がある方は、お申込み前にこちらをご確認ください。"
>
	<h1 class="prose-title">{page?.title ?? "よくある質問"}</h1>

	<section class="section">
		<div class="container">
			<div class="faq-list">
				{
					faqs.map((f, i) => (
						<details class="faq-item">
							<summary>
								<span class="q-mark">Q{i + 1}</span>
								{f.question}
							</summary>
							<div class="faq-answer" set:html={f.answer} />
						</details>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.prose-title {
		text-align: center;
		font-size: 1.9rem;
		margin: 1rem 0 2rem;
	}

	.faq-list {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.faq-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.1rem 1.5rem;
		interpolate-size: allow-keywords;
	}

	.faq-item::details-content {
		block-size: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			block-size 0.3s ease,
			opacity 0.2s ease,
			content-visibility 0.3s allow-discrete;
	}

	.faq-item[open]::details-content {
		block-size: auto;
		opacity: 1;
	}

	.faq-item summary {
		cursor: pointer;
		font-weight: 600;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::after {
		content: "+";
		margin-left: auto;
		color: var(--color-accent);
		font-size: 1.2rem;
	}

	.faq-item[open] summary::after {
		content: "−";
	}

	.q-mark {
		font-weight: 700;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.faq-answer {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px dashed var(--color-border);
		color: var(--color-ink-soft);
		font-size: 0.92rem;
		line-height: 1.8;
	}

	.faq-answer :global(p) {
		margin: 0;
	}

	.faq-answer :global(p + p),
	.faq-answer :global(ul),
	.faq-answer :global(ol) {
		margin-top: 0.75rem;
	}

	@media (max-width: 640px) {
		.prose-title {
			font-size: 1.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content {
			transition: none;
		}
	}
</style>
