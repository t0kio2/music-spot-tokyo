---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import { faqs as faqEntries } from "../data/faqs";
const currentYear = new Date().getFullYear();
const youngestAge = currentYear - 1999;
const oldestAge = currentYear - 1987;
const faqs = faqEntries.map((faq) => {
  if (!faq.question.includes("年齢層")) return faq;

  return {
    ...faq,
    answer: faq.answer
      .replace(
        /現在の参加者は\d+歳から\d+歳までです。/,
        `現在の参加者は${youngestAge}歳から${oldestAge}歳までです。`,
      )
      .replace(/その中でも多いのは\d+歳前後の方です。/, "その中でも多いのは30歳前後の方です。"),
  };
});
---

<Layout>
  <div class="faq-page">
    <PageHero
      className="faq-page__hero"
      compact
    />
    <section class="faq-page__content" aria-label="よくある質問一覧">
      <FaqList faqs={faqs} />
    </section>
  </div>
</Layout>
